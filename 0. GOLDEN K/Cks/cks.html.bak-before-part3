crictl info | grep -i runtime        <span class="comment"># which runtime + endpoint</span>
ctr -n k8s.io images ls              <span class="comment"># containerd-native image list</span>
nerdctl ps                           <span class="comment"># docker-compatible CLI for containerd (if installed)</span>
systemctl status containerd          <span class="comment"># is the runtime up?</span>

<span class="comment"># from the control plane — the Events line names the real pull/exit cause</span>
kubectl describe pod &lt;p&gt;</code></pre>
            </div>

