                <h4>Prometheus AlertManager Rules for Security</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — PrometheusRule: Security alerts for CKS-monitored cluster</span>
                    </div>
                    <pre><code class="language-yaml">apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: security-alerts
  namespace: monitoring
spec:
  groups:
  - name: cve-alerts
    rules:
    # P1: ANY CRITICAL CVE in production — page on-call immediately
    - alert: CriticalCVEInProduction
      expr: trivy_image_critical_cves{namespace=~"easypj-prod|prod-.*"} > 0
      for: 5m
      labels:
        severity: critical
        priority: P1
      annotations:
        summary: "CRITICAL CVE in {{ $labels.namespace }}/{{ $labels.image }}"
        description: "Image {{ $labels.image }} has {{ $value }} CRITICAL CVEs. Patch immediately."

    # P2: CIS benchmark pass rate drops below 95%
    - alert: CISBenchmarkDegraded
      expr: cis_checks_passed_ratio < 0.95
      for: 1h
      labels:
        severity: warning
        priority: P2
      annotations:
        summary: "CIS benchmark pass rate is {{ $value | humanizePercentage }}"

    # P2: Gatekeeper constraint violations in production
    - alert: GatekeeperViolationsInProd
      expr: gatekeeper_constraint_violations{namespace="easypj-prod"} > 0
      for: 15m
      labels:
        severity: warning
        priority: P2
      annotations:
        summary: "{{ $value }} Gatekeeper violations in easypj-prod"

    # P3: High Falco alert rate (possible attack in progress)
    - alert: HighFalcoAlertRate
      expr: rate(falco_events_total[1h]) > 50
      for: 10m
      labels:
        severity: warning
        priority: P3
      annotations:
        summary: "Falco alert rate is {{ $value | humanize }}/hour — possible attack"</code></pre>
