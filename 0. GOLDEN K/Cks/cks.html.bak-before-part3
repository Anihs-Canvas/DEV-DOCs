                <h4>Task C: Create Minimal RBAC for a Given Service Account</h4>
                <div class="scenario-box">
                    <div class="scenario-header"><span class="scenario-badge info">TASK</span><span class="scenario-title">Context: mk8s-cluster-2 | Time: 5 min | Points: 5</span></div>
                    <div class="scenario-steps">
                        <div class="scenario-step"><div class="step-marker">📋</div><div class="step-content"><strong>Objective:</strong> Create a ServiceAccount "reader" in namespace "app". Grant it permission to get, list, and watch pods in that namespace ONLY. Verify with kubectl auth can-i.</div></div>
                    </div>
                </div>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-lang">✅ Solution</span></div>
                    <pre><code class="language-bash"># Step 1: Create namespace and ServiceAccount
kubectl create ns app
kubectl create sa reader -n app

# Step 2: Create Role (pod reader only)
kubectl create role pod-reader -n app \
  --verb=get,list,watch \
  --resource=pods

# Step 3: Bind Role to ServiceAccount
kubectl create rolebinding pod-reader-binding -n app \
  --role=pod-reader \
  --serviceaccount=app:reader

