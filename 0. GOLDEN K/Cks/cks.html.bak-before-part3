                                <pre><code class="language-yaml"><span class="comment"># Imperative approach (generate YAML, then add resources)</span>
kubectl run web-pod --image=nginx:1.25-alpine \
  --labels=app=web \
  -n production \
  --dry-run=client -o yaml > web-pod.yaml

<span class="comment"># Then edit to add resources, or use the full YAML:</span>
apiVersion: v1
kind: Pod
metadata:
  name: web-pod
  namespace: production
  labels:
    app: web
spec:
  containers:
  - name: web-pod
