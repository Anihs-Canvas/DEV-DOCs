                    <pre><code class="language-yaml">apiVersion: apiserver.config.k8s.io/v1
kind: EncryptionConfiguration
resources:
- resources:
  - secrets
  providers:
  - aescbc:
      keys:
      - name: key1
        secret: &lt;base64-encoded-32-byte-key&gt;
  - identity: {}
# ═══════════════════════════════════════════
# API server config (kube-apiserver.yaml):
