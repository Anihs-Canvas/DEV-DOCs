                    <details>
                        <summary>View Solution</summary>
<pre><code class="language-bash"># 1. Deny-all FIRST (order matters for this drill — prove the collision is real)
kubectl apply -f - <<EOF
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: default-deny-ingress, namespace: easypj-prod}
spec: {podSelector: {}, policyTypes: [Ingress]}
EOF

# 2. Request a cert via HTTP-01 — watch it hang
kubectl apply -f - <<EOF
apiVersion: cert-manager.io/v1
kind: Certificate
metadata: {name: easypj-tls, namespace: easypj-prod}
spec:
  secretName: easypj-tls
  dnsNames: [jobs.easypj.test]
  issuerRef: {name: letsencrypt-staging, kind: ClusterIssuer}
EOF
kubectl get challenge -n easypj-prod -w
# → stuck at "Waiting for HTTP-01 challenge propagation" — confirm the collision

# 3. Apply ONLY the narrow fix from Q3 — do not touch default-deny-ingress
kubectl apply -f - <<EOF
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: allow-acme-http01-solver, namespace: easypj-prod}
spec:
  podSelector: {matchLabels: {acme.cert-manager.io/http01-solver: "true"}}
  policyTypes: [Ingress]
  ingress: [{from: [], ports: [{protocol: TCP, port: 8089}]}]
EOF
kubectl get certificate easypj-tls -n easypj-prod -w   # → READY: True within ~60s</code></pre>
