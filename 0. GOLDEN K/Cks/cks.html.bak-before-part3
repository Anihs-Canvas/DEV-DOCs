                <div class="scenario-box">
                    <div class="scenario-header"><span class="scenario-badge info">TASK</span><span class="scenario-title">Context: mk8s-cluster-4 | Time: 6 min | Points: 5</span></div>
                    <div class="scenario-steps">
                        <div class="scenario-step"><div class="step-marker">📋</div><div class="step-content"><strong>Objective:</strong> Label namespace "secure-app" with PSS Restricted enforcement. Create a pod that violates Restricted. Observe the rejection. Fix the pod to comply.</div></div>
                    </div>
                </div>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-lang">✅ Solution</span></div>
                    <pre><code class="language-bash"># Step 1: Create namespace with PSS Restricted
kubectl create ns secure-app
kubectl label ns secure-app \
  pod-security.kubernetes.io/enforce=restricted \
  pod-security.kubernetes.io/enforce-version=v1.30

# Step 2: Try creating a pod that VIOLATES Restricted (runs as root)
kubectl run bad-pod --image=nginx -n secure-app
# Expected: Error: pods "bad-pod" is forbidden: violates PodSecurity "restricted:v1.30":
#   runAsNonRoot != true, seccompProfile...

# Step 3: Fix the pod — add required securityContext
cat &lt;&lt;EOF | kubectl apply -f -
apiVersion: v1
kind: Pod
metadata:
  name: good-pod
  namespace: secure-app
spec:
  securityContext:
    runAsNonRoot: true
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: nginx
    image: nginx:alpine   # Alpine nginx runs as non-root
    securityContext:
      allowPrivilegeEscalation: false
      capabilities:
        drop: ["ALL"]
EOF
# ✅ Pod created successfully</code></pre>
