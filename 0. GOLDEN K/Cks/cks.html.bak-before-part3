                <h4>Task B: Create OPA ConstraintTemplate to Block Unapproved Images</h4>
                <div class="scenario-box">
                    <div class="scenario-header"><span class="scenario-badge info">TASK</span><span class="scenario-title">Context: mk8s-cluster-5 | Time: 10 min | Points: 7</span></div>
                    <div class="scenario-steps">
                        <div class="scenario-step"><div class="step-marker">📋</div><div class="step-content"><strong>Objective:</strong> Create a Gatekeeper ConstraintTemplate + Constraint that only allows images from <code>registry.k8s.io/*</code> and <code>nginx:alpine</code>. Test by creating a pod with a disallowed image — it should be rejected.</div></div>
                    </div>
                </div>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-lang">✅ Solution</span></div>
                    <pre><code class="language-yaml"># Step 1: Create ConstraintTemplate
cat &lt;&lt;EOF | kubectl apply -f -
apiVersion: templates.gatekeeper.sh/v1beta1
kind: ConstraintTemplate
metadata:
  name: k8sallowedrepos
spec:
  crd:
    spec:
      names:
        kind: K8sAllowedRepos
      validation:
        openAPIV3Schema:
          properties:
            repos:
              type: array
              items:
                type: string
  targets:
  - target: admission.k8s.gatekeeper.sh
    rego: |
      package k8sallowedrepos
      violation[{"msg": msg}] {
        container := input.review.object.spec.containers[_]
        satisfied := [good | repo := input.parameters.repos[_]; good := startswith(container.image, repo)]
        not any(satisfied)
        msg := sprintf("container <%v> uses disallowed image <%v>", [container.name, container.image])
      }
EOF

# Step 2: Create Constraint
cat &lt;&lt;EOF | kubectl apply -f -
apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sAllowedRepos
metadata:
  name: allowed-registries
spec:
  enforcementAction: deny
  match:
    kinds:
    - apiGroups: [""]
      kinds: [Pod]
  parameters:
    repos:
    - "registry.k8s.io/"
    - "nginx:alpine"
EOF

# Step 3: Test — allowed image should WORK
kubectl run test-allowed --image=nginx:alpine
# Expected: pod/test-allowed created ✅

# Step 4: Test — disallowed image should FAIL
kubectl run test-blocked --image=nginx:latest
# Expected: Error: admission webhook "validation.gatekeeper.sh" denied</code></pre>
