    argocd.argoproj.io/sync-wave: "0"    # Deploy FIRST (before API server restarts)
data:
  audit-policy.yaml: |
    apiVersion: audit.k8s.io/v1
    kind: Policy
    rules:
    # Log secret access (who read which secret)
    - level: Metadata
      resources:
      - group: ""
        resources: ["secrets"]

    # Log pod exec (who got a shell)
    - level: RequestResponse
      verbs: ["create"]
      resources:
      - group: ""
        resources: ["pods/exec"]

    # Log RBAC changes (who granted permissions)
    - level: RequestResponse
      verbs: ["create", "update", "delete"]
      resources:
      - group: "rbac.authorization.k8s.io"
        resources: ["clusterroles", "clusterrolebindings", "roles", "rolebindings"]

    # Log NetworkPolicy changes
    - level: RequestResponse
      verbs: ["create", "update", "delete"]
      resources:
      - group: "networking.k8s.io"
        resources: ["networkpolicies"]

    # Suppress noise: don't log read-only operations
    - level: None
      verbs: ["get", "list", "watch"]
      resources:
      - group: ""
        resources: ["pods", "services", "endpoints", "nodes", "configmaps"]</code></pre>
