            <!-- ═══════════ SECTION 33.3 ═══════════ -->
            <section class="section-block" id="s33-3">
                <h3 class="section-h">33.3 Step 2 — Harden the Pod Security Context</h3>
                <p>The pod <code>securityContext</code> is your <strong>last line of defense</strong> inside the container. Even if an attacker exploits a CVE and gets code execution, the securityContext limits what they can do. This section builds the complete hardened pod spec — every field explained, every rationale documented.</p>

                <h4>Complete Hardened Pod Spec for easypj</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — Full easypj Deployment with hardened securityContext</span>
                    </div>
                    <pre><code class="language-yaml">apiVersion: apps/v1
kind: Deployment
metadata:
  name: easypj
  namespace: easypj-prod
  labels:
    app: easypj
    security-tier: restricted
spec:
  replicas: 3
  selector:
    matchLabels:
      app: easypj
  template:
    metadata:
      labels:
        app: easypj
      annotations:
        # Seccomp profile applied at container runtime
        container.apparmor.security.beta.kubernetes.io/easypj: localhost/easypj-apparmor
    spec:
      # === POD-LEVEL SECURITY CONTEXT ===
      securityContext:
        runAsNonRoot: true        # Reject if image runs as root
        runAsUser: 1000           # Specific UID (matches Dockerfile USER)
        runAsGroup: 1000          # Specific GID
        fsGroup: 1000             # Volume mounts owned by this GID
        seccompProfile:
          type: RuntimeDefault    # Kernel syscall filtering

      # Dedicated ServiceAccount (NOT default)
      serviceAccountName: easypj-sa
      # Disable automount — only pods that need API access mount token
      automountServiceAccountToken: false

      # === INIT CONTAINER — runs first, sets up volumes ===
      initContainers:
      - name: init-db-check
        image: ghcr.io/anihs-canvas/easypj:latest
        command: ["python", "manage.py", "check", "--database", "default"]
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop: ["ALL"]

      containers:
      - name: easypj
        image: ghcr.io/anihs-canvas/easypj@sha256:abc123...  # Digest, NOT :latest
        ports:
        - containerPort: 8000
          protocol: TCP

        # === CONTAINER-LEVEL SECURITY CONTEXT ===
        securityContext:
          # 1. RUN AS NON-ROOT (matches Dockerfile USER easypj)
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000

          # 2. NO PRIVILEGE ESCALATION (setuid binaries ignored)
          allowPrivilegeEscalation: false

          # 3. READ-ONLY ROOT FILESYSTEM (attacker can't write to disk)
          readOnlyRootFilesystem: true

          # 4. DROP ALL LINUX CAPABILITIES (even from root)
          capabilities:
            drop:
            - ALL

          # 5. SECCOMP PROFILE (kernel syscall whitelist)
          seccompProfile:
            type: RuntimeDefault

        # === ENVIRONMENT (secrets from Secrets, NOT plaintext!) ===
        env:
        - name: DB_HOST
          value: "postgres.easypj-prod.svc.cluster.local"
        - name: DB_NAME
          value: "easypj"
        - name: SECRET_KEY
          valueFrom:
            secretKeyRef:
              name: easypj-secrets
              key: django-secret-key
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              name: easypj-secrets
              key: db-password
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: easypj-secrets
              key: redis-password

        # === RESOURCE LIMITS (prevent DoS) ===
        resources:
          requests:
            memory: "256Mi"
            cpu: "250m"
          limits:
            memory: "512Mi"
            cpu: "500m"

        # === LIVENESS & READINESS PROBES ===
        livenessProbe:
          httpGet:
            path: /healthz/
            port: 8000
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready/
            port: 8000
          initialDelaySeconds: 10
          periodSeconds: 5

        # === VOLUME MOUNTS (writable directories) ===
        volumeMounts:
        - name: tmp
          mountPath: /tmp          # Writable /tmp for Python temp files
        - name: media
          mountPath: /app/media    # User uploads need writable storage

      volumes:
      - name: tmp
        emptyDir:
          sizeLimit: 100Mi         # Prevent /tmp from filling the node
      - name: media
        persistentVolumeClaim:
          claimName: easypj-media-pvc</code></pre>
                </div>

                <h4>SecurityContext Field Reference — Every Field Explained</h4>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Field</th><th>Value</th><th>What It Prevents</th><th>CKS Exam Relevance</th></tr></thead>
                        <tbody>
                            <tr><td><strong>runAsNonRoot</strong></td><td><code>true</code></td><td>Container running as UID 0 (root). Kubelet rejects pod if image USER is root.</td><td>⭐⭐⭐ Must-know. Core PSS Restricted requirement.</td></tr>
                            <tr><td><strong>runAsUser</strong></td><td><code>1000</code></td><td>Unpredictable UID. Explicit UID ensures volume permissions match.</td><td>⭐⭐ Common. Often combined with fsGroup.</td></tr>
                            <tr><td><strong>allowPrivilegeEscalation</strong></td><td><code>false</code></td><td>setuid binaries (su, sudo, passwd). Child processes can't gain more privileges than parent.</td><td>⭐⭐⭐ Must-know. Required by PSS Restricted.</td></tr>
                            <tr><td><strong>readOnlyRootFilesystem</strong></td><td><code>true</code></td><td>Writing to container filesystem. Malware installation, persistence, binary replacement all blocked.</td><td>⭐⭐⭐ Must-know. Ch31 covers this in depth.</td></tr>
                            <tr><td><strong>capabilities.drop</strong></td><td><code>["ALL"]</code></td><td>All 14 default Linux capabilities. Even as root, container can't load kernel modules, bind to ports &lt;1024, change network config.</td><td>⭐⭐⭐ Must-know. Single most impactful securityContext field.</td></tr>
                            <tr><td><strong>seccompProfile</strong></td><td><code>RuntimeDefault</code></td><td>~300 syscalls blocked. Prevents container from calling dangerous syscalls like <code>ptrace</code>, <code>mount</code>, <code>kexec_load</code>.</td><td>⭐⭐⭐ Must-know. Required by PSS Restricted.</td></tr>
                            <tr><td><strong>fsGroup</strong></td><td><code>1000</code></td><td>Volumes owned by wrong GID (root). Ensures non-root container can read/write mounted volumes.</td><td>⭐⭐ Troubleshooting. "Why can't my pod write to the volume?"</td></tr>
                        </tbody>
                    </table>
                </div>

                <h4>AppArmor Profile — Restrict easypj at the Kernel Level</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">AppArmor — Custom profile restricting Django app to only what it needs</span>
                    </div>
                    <pre><code class="language-text"># /etc/apparmor.d/container-easypj
#include &lt;tunables/global&gt;

profile easypj-apparmor flags=(attach_disconnected,mediate_deleted) {
  #include &lt;abstractions/base&gt;
  #include &lt;abstractions/python&gt;
  #include &lt;abstractions/ssl_certs&gt;

  # Allow reading application code and config
  /app/**                        r,
  /opt/venv/**                   r,

  # Allow writing ONLY to explicitly mounted volumes
  /tmp/**                        rw,
  /app/media/**                  rw,

  # Allow networking (Django serves HTTP on port 8000)
  network inet tcp,
  network inet6 tcp,

  # Deny everything else by default
  deny /etc/passwd               w,    # Can't modify user database
  deny /etc/shadow               rw,   # Can't read password hashes
  deny /root/**                  rw,   # Can't access root home
  deny /proc/sys/**              w,    # Can't modify kernel parameters
  deny /sys/**                   w,    # Can't modify sysfs

  # Explicitly deny dangerous capabilities (redundant with drop ALL, defense-in-depth)
  deny capability sys_admin,
  deny capability sys_ptrace,
  deny capability sys_module,
}</code></pre>
                </div>

                <h4>What Happens WITHOUT Each securityContext Field — Failure Scenarios</h4>
                <p>Understanding what <em>fails</em> when you omit a securityContext field is as important as knowing what to set. Here's what goes wrong without each:</p>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Missing Field</th><th>What Actually Happens</th><th>Real-World Attack Example</th></tr></thead>
                        <tbody>
                            <tr><td><strong>No runAsNonRoot</strong></td><td>Container runs as UID 0. <code>whoami</code> returns "root". All files created on volumes are owned by root, causing permission issues for non-root sidecars.</td><td>2021 CodeCov breach: attacker modified a bash uploader script running as root, gained host access.</td></tr>
                            <tr><td><strong>No readOnlyRootFilesystem</strong></td><td><code>touch /tmp/test</code> succeeds. Attacker can <code>wget malware && chmod +x malware && ./malware</code>. <code>echo "* * * * * cmd" >> /etc/crontab</code> persists across restarts.</td><td>2023 Kinsing malware: targets writable container filesystems to install crypto miners that survive pod restarts.</td></tr>
                            <tr><td><strong>No allowPrivilegeEscalation: false</strong></td><td>Setuid binaries work. <code>sudo</code>, <code>su</code>, <code>passwd</code> can elevate privileges. Child processes can gain capabilities the parent didn't have.</td><td>Container escape via <code>su -</code> to root, then exploiting <code>CAP_SYS_ADMIN</code> to mount host filesystem.</td></tr>
                            <tr><td><strong>No capabilities.drop: [ALL]</strong></td><td>Container gets ALL default Linux capabilities: <code>CAP_CHOWN</code>, <code>CAP_DAC_OVERRIDE</code>, <code>CAP_FOWNER</code>, <code>CAP_SETUID</code>, <code>CAP_NET_BIND_SERVICE</code>, <code>CAP_SYS_PTRACE</code>, etc. — 14 total.</td><td>With <code>CAP_SYS_PTRACE</code>: inject code into host processes. With <code>CAP_NET_RAW</code>: ARP spoofing. With <code>CAP_SYS_ADMIN</code>: mount host filesystem.</td></tr>
                            <tr><td><strong>No seccompProfile</strong></td><td>Container runs "unconfined" — all ~300 syscalls available. <code>mount</code>, <code>ptrace</code>, <code>kexec_load</code>, <code>reboot</code> all callable.</td><td>Attacker can <code>mount -t proc proc /host-proc</code> to read host process info. Can <code>kexec</code> to boot a malicious kernel.</td></tr>
                            <tr><td><strong>No AppArmor/SELinux</strong></td><td>No mandatory access control. Even without capabilities, certain file accesses and network operations may be possible depending on kernel config.</td><td>Reading <code>/etc/shadow</code> (hashed passwords), writing to <code>/proc/sysrq-trigger</code> (immediate reboot).</td></tr>
                        </tbody>
                    </table>
                </div>

                <h4>Verifying Your SecurityContext Is Actually Working</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">Bash — Test each securityContext field from inside the pod</span>
                    </div>
                    <pre><code class="language-bash"># 1. Verify non-root: should return UID 1000, not 0
kubectl exec deploy/easypj -n easypj-prod -- whoami
# Expected: easypj (or "whoami: cannot find name for user ID 1000")
# ❌ If it returns "root" → runAsNonRoot is NOT working

# 2. Verify read-only filesystem: should FAIL
kubectl exec deploy/easypj -n easypj-prod -- touch /test-file
# Expected: touch: cannot touch '/test-file': Read-only file system
# ❌ If it succeeds → readOnlyRootFilesystem is NOT set

# 3. Verify writable volumes: should SUCCEED (emptyDir /tmp)
kubectl exec deploy/easypj -n easypj-prod -- touch /tmp/test-file
# Expected: SUCCESS (silent)
# ❌ If it fails → emptyDir mount is broken

# 4. Verify capabilities dropped: should show 0000000000000000
kubectl exec deploy/easypj -n easypj-prod -- cat /proc/1/status | grep CapEff
# Expected: CapEff: 0000000000000000 (zero = all dropped)
# ❌ If it shows hex digits → some capabilities are still present

# 5. Verify Seccomp is active
kubectl exec deploy/easypj -n easypj-prod -- cat /proc/1/status | grep Seccomp
# Expected: Seccomp: 2 (filter mode)
# 0 = disabled, 1 = strict, 2 = filter (RuntimeDefault = filter)

# 6. Verify privilege escalation blocked: should show NoNewPrivs
kubectl exec deploy/easypj -n easypj-prod -- cat /proc/1/status | grep NoNewPrivs
# Expected: NoNewPrivs: 1
# ❌ If 0 → allowPrivilegeEscalation is NOT set to false

# 7. Check AppArmor status (requires aa-status on host)
# From the NODE (not the pod):
cat /proc/$(crictl inspect $(crictl pods --name easypj -q) | jq -r .info.pid)/attr/current
# Expected: easypj-apparmor (enforce)
# ❌ If "unconfined" → AppArmor profile is NOT applied</code></pre>
                </div>

                <h4>Debugging Common securityContext Mistakes</h4>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Symptom</th><th>Likely Cause</th><th>Fix</th></tr></thead>
                        <tbody>
                            <tr><td><strong>Pod stuck in CreateContainerError</strong></td><td>AppArmor profile <code>localhost/easypj-apparmor</code> doesn't exist on the node. Kubernetes can't create the container.</td><td>SSH to node, verify <code>/etc/apparmor.d/container-easypj</code> exists and is loaded: <code>apparmor_parser -r /etc/apparmor.d/container-easypj</code></td></tr>
                            <tr><td><strong>"Permission denied" writing to /app/media</strong></td><td>Volume is mounted as root-owned. <code>fsGroup</code> not set or set to wrong GID.</td><td>Verify <code>securityContext.fsGroup: 1000</code> is set at pod level. Check PVC access mode.</td></tr>
                            <tr><td><strong>"cannot find name for user ID 1000"</strong></td><td>Dockerfile has USER 1000 but doesn't create the user account. This is a warning, not an error — it still works.</td><td>Add <code>RUN groupadd -r easypj && useradd -r -g easypj -m -s /bin/bash easypj</code> to Dockerfile for clean output.</td></tr>
                            <tr><td><strong>Pod rejected: "violates PodSecurity"</strong></td><td>PSS Restricted enforcement is active but pod spec doesn't meet requirements.</td><td>Check which specific PSS control is violated: <code>kubectl describe ns easypj-prod</code> to see enforce/warn labels.</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- ═══════════ SECTION 33.4 ═══════════ -->
            <section class="section-block" id="s33-4">
                <h3 class="section-h">33.4 Step 3 — Namespace and Admission Control</h3>
                <p>Pod security is only as strong as the <strong>admission control</strong> enforcing it. A developer can accidentally (or maliciously) remove a securityContext field. Admission controllers <strong>gatekeep every API request</strong> — they reject or mutate pods before they're created.</p>

                <h4>PSS Enforcement — Label Namespaces for Pod Security Standards</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — Namespace labels enforcing PSS Restricted in production, Baseline in dev</span>
                    </div>
                    <pre><code class="language-yaml">---
# Production namespace: FULL PSS Restricted enforcement
apiVersion: v1
kind: Namespace
metadata:
  name: easypj-prod
  labels:
    # ENFORCE: Reject any pod that violates PSS Restricted
    pod-security.kubernetes.io/enforce: restricted
    pod-security.kubernetes.io/enforce-version: v1.30
    # WARN: Show warning for non-compliant pods (useful for developers)
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/warn-version: v1.30
    # AUDIT: Log violations without blocking (for monitoring)
    pod-security.kubernetes.io/audit: restricted
    pod-security.kubernetes.io/audit-version: v1.30
---
# Development namespace: PSS Baseline (allows some flexibility)
apiVersion: v1
kind: Namespace
metadata:
  name: easypj-dev
  labels:
    pod-security.kubernetes.io/enforce: baseline
    pod-security.kubernetes.io/enforce-version: v1.30
    pod-security.kubernetes.io/warn: restricted
    pod-security.kubernetes.io/warn-version: v1.30</code></pre>
                </div>

                <h4>Kyverno Policy — Verify Cosign Image Signatures</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — Kyverno ClusterPolicy: Only allow signed images from ghcr.io/anihs-canvas</span>
                    </div>
                    <pre><code class="language-yaml">apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: verify-easypj-signatures
spec:
  validationFailureAction: Enforce   # BLOCK unsigned images
  background: true                    # Also check existing pods
  rules:
  - name: check-image-signature
    match:
      any:
      - resources:
          kinds: [Pod]
          namespaces: [easypj-prod]
    verifyImages:
    - imageReferences:
      - "ghcr.io/anihs-canvas/*"     # Only our registry
      attestors:
      - count: 1
        entries:
        - keyless:                     # Verify via OIDC (GitHub Actions)
            subject: "https://github.com/Anihs-Canvas/DEV-DOCs/.github/workflows/build.yml@refs/heads/main"
            issuer: "https://token.actions.githubusercontent.com"
            rekor:
              url: https://rekor.sigstore.dev</code></pre>
                </div>

                <h4>OPA Gatekeeper — Restrict Image Registries</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — Gatekeeper Constraint: Only allow images from approved registries</span>
                    </div>
                    <pre><code class="language-yaml">apiVersion: constraints.gatekeeper.sh/v1beta1
kind: K8sAllowedRepos
metadata:
  name: approved-registries-only
spec:
  enforcementAction: deny
  match:
    kinds:
    - apiGroups: [""]
      kinds: [Pod]
    namespaces: ["easypj-prod", "easypj-dev"]
  parameters:
    repos:
    - "ghcr.io/anihs-canvas/"       # Our private registry
    - "ghcr.io/anihs-canvas"         # (with/without trailing slash)
    - "registry.k8s.io/*"            # Kubernetes system images
    # ❌ Docker Hub blocked — prevents supply chain attacks
    # ❌ Quay.io blocked unless explicitly added</code></pre>
                </div>

                <h4>PSS Enforcement Modes — Audit vs Warn vs Enforce</h4>
                <p>Pod Security Standards have <strong>three enforcement modes</strong>. You can apply them independently — this is how you do gradual rollout:</p>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Mode</th><th>What It Does</th><th>Pod Result</th><th>When to Use</th></tr></thead>
                        <tbody>
                            <tr><td><strong>enforce</strong></td><td>REJECTS non-compliant pods. The admission controller returns HTTP 403.</td><td>❌ Pod NOT created</td><td>After all violations are remediated. Production-ready namespaces.</td></tr>
                            <tr><td><strong>warn</strong></td><td>Shows a WARNING to the user who created the pod. Pod is still created.</td><td>⚠️ Created with warning</td><td>During migration. Let developers see what needs fixing.</td></tr>
                            <tr><td><strong>audit</strong></td><td>Logs the violation to the audit log. No feedback to user. Pod is created silently.</td><td>✅ Created silently</td><td>Initial deployment. Measure violation count before enforcing.</td></tr>
                        </tbody>
                    </table>
                </div>
                <p><strong>Best practice:</strong> Apply all three labels simultaneously. <code>enforce=restricted</code> blocks violations, <code>warn=restricted</code> tells developers WHY, <code>audit=restricted</code> creates a permanent audit trail.</p>

                <h4>What Happens When PSS Blocks a Pod — The Error Message</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">Bash — Expected error when PSS Restricted rejects a pod</span>
                    </div>
                    <pre><code class="language-bash"># Try deploying a pod that runs as root to a restricted namespace
kubectl run test-root --image=nginx -n easypj-prod

# Error output:
# Error from server (Forbidden): admission webhook "validation.gatekeeper.sh"
# denied the request: pods "test-root" is forbidden: violates
# PodSecurity "restricted:v1.30":
#   runAsNonRoot != true (pod must set securityContext.runAsNonRoot=true)
#   runAsUser != 0 (container "nginx" must not set securityContext.runAsUser=0)
#   seccompProfile (pod must set securityContext.seccompProfile.type to
#     "RuntimeDefault" or "Localhost")

# This tells you EXACTLY what to fix. Three violations, three fixes needed.</code></pre>
                </div>

                <h4>Kyverno vs Gatekeeper — Which Admission Controller When?</h4>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Decision Factor</th><th>Use Kyverno</th><th>Use Gatekeeper</th></tr></thead>
                        <tbody>
                            <tr><td><strong>Policy language</strong></td><td>YAML (Kubernetes-native, no new language)</td><td>Rego (powerful but steep learning curve)</td></tr>
                            <tr><td><strong>Image verification</strong></td><td>✅ Built-in <code>verifyImages</code> for cosign/notation</td><td>⚠️ Requires external data + custom Rego</td></tr>
                            <tr><td><strong>Mutation (auto-fix)</strong></td><td>✅ Built-in <code>mutate</code> rules</td><td>⚠️ Mutation support is newer, less mature</td></tr>
                            <tr><td><strong>Policy generation</strong></td><td>✅ Auto-generate policies from existing resources</td><td>❌ Manual Rego coding required</td></tr>
                            <tr><td><strong>Audit + reporting</strong></td><td>✅ PolicyReports per namespace</td><td>✅ Constraint status with violation counts</td></tr>
                            <tr><td><strong>CKS exam</strong></td><td>✅ Appears in CKS (simpler YAML syntax)</td><td>✅ Appears in CKS (Rego-based ConstraintTemplates)</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- ═══════════ SECTION 33.5 ═══════════ -->
            <section class="section-block" id="s33-5">
                <h3 class="section-h">33.5 Step 4 — RBAC and Service Accounts</h3>
                <p>Every pod gets a ServiceAccount. The <strong>default</strong> ServiceAccount has whatever permissions the cluster admin accidentally left on it. <strong>Least privilege RBAC</strong> means: create dedicated SAs, bind only the minimum permissions needed, disable automount for pods that don't talk to the API server.</p>

                <h4>Complete RBAC Manifest Set for easypj in Production</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — ServiceAccounts, Roles, and RoleBindings for easypj workloads</span>
                    </div>
                    <pre><code class="language-yaml">---
# ============================================================
# SERVICE ACCOUNTS — One per workload, NOT the default SA
# ============================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  name: easypj-sa
  namespace: easypj-prod
automountServiceAccountToken: false   # easypj doesn't call K8s API

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: postgres-sa
  namespace: easypj-prod
automountServiceAccountToken: false   # Database doesn't need API access

---
# CI/CD pipeline needs to update deployments — MINIMAL permissions
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cicd-deployer
  namespace: easypj-prod
# This one NEEDS a token — CI/CD uses it to authenticate

---
# ============================================================
# ROLES — Minimal permissions scoped to specific resources
# ============================================================
# CI/CD role: ONLY update Deployments and read ConfigMaps
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: cicd-deployer
  namespace: easypj-prod
rules:
- apiGroups: ["apps"]
  resources: ["deployments"]
  verbs: ["get", "list", "watch", "update", "patch"]   # No create/delete!
- apiGroups: ["apps"]
  resources: ["deployments/status"]
  verbs: ["get"]
- apiGroups: [""]
  resources: ["configmaps"]
  verbs: ["get", "list"]                                 # Read-only ConfigMaps

---
# Monitoring role: Read pods and metrics
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: monitoring-reader
  namespace: easypj-prod
rules:
- apiGroups: [""]
  resources: ["pods", "pods/log", "services", "endpoints"]
  verbs: ["get", "list", "watch"]                        # Read-only

---
# ============================================================
# ROLE BINDINGS — Connect SAs to Roles
# ============================================================
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: cicd-deployer-binding
  namespace: easypj-prod
subjects:
- kind: ServiceAccount
  name: cicd-deployer
  namespace: easypj-prod
roleRef:
  kind: Role
  name: cicd-deployer
  apiGroup: rbac.authorization.k8s.io

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: monitoring-binding
  namespace: easypj-prod
subjects:
- kind: ServiceAccount
  name: prometheus-sa
  namespace: monitoring
roleRef:
  kind: Role
  name: monitoring-reader
  apiGroup: rbac.authorization.k8s.io</code></pre>
                </div>

                <h4>Verifying Least Privilege — kubectl auth can-i</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">Bash — Audit RBAC: Verify each SA has only the permissions it needs</span>
                    </div>
                    <pre><code class="language-bash"># Test: Can CI/CD SA create a Deployment? (should be NO — only update)
kubectl auth can-i create deployments \
  --as=system:serviceaccount:easypj-prod:cicd-deployer \
  -n easypj-prod
# Expected: no

# Test: Can CI/CD SA update a Deployment? (should be YES)
kubectl auth can-i update deployments \
  --as=system:serviceaccount:easypj-prod:cicd-deployer \
  -n easypj-prod
# Expected: yes

# Test: Can CI/CD SA delete a Deployment? (should be NO)
kubectl auth can-i delete deployments \
  --as=system:serviceaccount:easypj-prod:cicd-deployer \
  -n easypj-prod
# Expected: no

# Test: Can CI/CD SA access another namespace? (should be NO)
kubectl auth can-i get pods \
  --as=system:serviceaccount:easypj-prod:cicd-deployer \
  -n kube-system
# Expected: no

# Test: Can easypj SA access the API at all? (should be NO — token not mounted)
kubectl auth can-i get pods \
  --as=system:serviceaccount:easypj-prod:easypj-sa
# Expected: no (token not mounted, so can't even authenticate)

# Audit ALL permissions of a SA
kubectl auth can-i --list \
  --as=system:serviceaccount:easypj-prod:cicd-deployer \
  -n easypj-prod</code></pre>
                </div>

                <div class="info-box warning">
                    <div class="info-box-title">⚠️ Default ServiceAccount Is a Security Risk</div>
                    <p>Every namespace has a <code>default</code> ServiceAccount automatically. If you don't specify <code>serviceAccountName</code> in your pod spec, Kubernetes uses this default SA. Any permissions bound to the default SA are available to EVERY pod in the namespace. <strong>Always</strong> create dedicated SAs and set <code>automountServiceAccountToken: false</code> for pods that don't need API access. This single change prevents an entire class of lateral movement attacks.</p>
                </div>

                <h4>RBAC Decision Matrix — Who Can Do What?</h4>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>ServiceAccount</th><th>Pods</th><th>Deployments</th><th>Secrets</th><th>ConfigMaps</th><th>Other NS</th><th>API Token?</th></tr></thead>
                        <tbody>
                            <tr><td><strong>easypj-sa</strong></td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>❌ Not mounted</td></tr>
                            <tr><td><strong>postgres-sa</strong></td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>❌ Not mounted</td></tr>
                            <tr><td><strong>cicd-deployer</strong></td><td>❌</td><td>✅ Get/Update</td><td>❌</td><td>✅ Read</td><td>❌</td><td>✅ Mounted</td></tr>
                            <tr><td><strong>prometheus-sa</strong></td><td>✅ Read</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>✅ Mounted</td></tr>
                            <tr><td><strong>default</strong></td><td>❌ (no bindings)</td><td>❌</td><td>❌</td><td>❌</td><td>❌</td><td>⚠️ Mounted (but useless)</td></tr>
                        </tbody>
                    </table>
                </div>

                <h4>RBAC Escalation Paths — What an Attacker Can Do with Each Permission</h4>
                <p>Understanding RBAC from the attacker's perspective reveals why least privilege matters. Here's what each permission enables:</p>
                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Permission</th><th>Attacker Capability</th><th>Severity</th></tr></thead>
                        <tbody>
                            <tr><td><strong>secrets: get, list</strong></td><td>Read ALL secrets in the namespace. Database passwords, API keys, TLS certs — everything. With <code>list</code>, they can enumerate every secret without knowing names.</td><td>🔴 CRITICAL — Full credential compromise</td></tr>
                            <tr><td><strong>pods/exec: create</strong></td><td>Get shell access to ANY pod in the namespace. <code>kubectl exec -it db-pod -- bash</code>. Can read files, view processes, access mounted secrets.</td><td>🔴 CRITICAL — Shell access to all workloads</td></tr>
                            <tr><td><strong>deployments: create</strong></td><td>Create new pods with ANY spec: privileged containers, hostPath volumes, hostNetwork. Can deploy a malicious pod that escapes to the host.</td><td>🔴 CRITICAL — Arbitrary pod creation</td></tr>
                            <tr><td><strong>roles: create + rolebindings: create</strong></td><td>Create a new Role with full permissions, bind it to own ServiceAccount. Effectively grants cluster-admin to self.</td><td>🔴 CRITICAL — Privilege escalation</td></tr>
                            <tr><td><strong>configmaps: get, list</strong></td><td>Read configuration data. May contain database connection strings, feature flags, service endpoints. Often overlooked as sensitive.</td><td>🟠 HIGH — Information disclosure</td></tr>
                            <tr><td><strong>pods: get, list, watch</strong></td><td>Monitor pod IPs, names, labels. Useful for reconnaissance — mapping the cluster before attacking.</td><td>🟡 MEDIUM — Reconnaissance</td></tr>
                            <tr><td><strong>services: get, list</strong></td><td>Discover all internal services. Find databases, caches, internal APIs that aren't publicly exposed.</td><td>🟡 MEDIUM — Service discovery</td></tr>
                        </tbody>
                    </table>
                </div>

                <h4>ServiceAccount Token Internals — What's Actually in That Mounted File</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">Bash — Inspect a Kubernetes ServiceAccount token (JWT)</span>
                    </div>
                    <pre><code class="language-bash"># The token is a JWT. Decode its payload (middle section):
kubectl exec deploy/easypj -n easypj-prod -- \
  cat /var/run/secrets/kubernetes.io/serviceaccount/token | \
  cut -d. -f2 | base64 -d | jq .

# Output:
# {
#   "aud": ["https://kubernetes.default.svc"],  # Who this token is for
#   "exp": 1753600000,                           # Expiration (1 hour typical)
#   "iat": 1753596400,                           # Issued at
#   "iss": "https://kubernetes.default.svc",     # Issuer
#   "kubernetes.io": {
#     "namespace": "easypj-prod",
#     "serviceaccount": {
#       "name": "easypj-sa",                     # Which SA this token belongs to
#       "uid": "abc123-def456"
#     }
#   },
#   "sub": "system:serviceaccount:easypj-prod:easypj-sa"
# }

# The API server VALIDATES this token on every request. If automountServiceAccountToken
# is false, this file doesn't exist — the pod has NO API access.</code></pre>
                </div>
            </section>

            <!-- ═══════════ SECTION 33.6 ═══════════ -->
            <section class="section-block" id="s33-6">
                <h3 class="section-h">33.6 Step 5 — Network Isolation</h3>
                <p>Without NetworkPolicies, <strong>every pod can talk to every other pod</strong> in the cluster. NetworkPolicy is the firewall — it defines which pods can communicate. The CKS gold standard is <strong>default-deny-all</strong> with explicit allow rules for each required communication path.</p>

                <h4>Complete NetworkPolicy Set for easypj</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — All NetworkPolicies: Default deny + explicit allow rules</span>
                    </div>
                    <pre><code class="language-yaml">---
# ============================================================
# POLICY 0: DEFAULT DENY ALL — Block everything first
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: default-deny-all
  namespace: easypj-prod
spec:
  podSelector: {}            # Applies to ALL pods in namespace
  policyTypes:
  - Ingress                  # Block ALL incoming traffic
  - Egress                   # Block ALL outgoing traffic
  # No ingress/egress rules = deny everything

---
# ============================================================
# POLICY 1: ALLOW ingress → easypj (port 8000)
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-ingress-to-easypj
  namespace: easypj-prod
spec:
  podSelector:
    matchLabels:
      app: easypj              # Applies to easypj pods
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: ingress-nginx   # Only from ingress controller namespace
    ports:
    - protocol: TCP
      port: 8000               # Only on Django app port

---
# ============================================================
# POLICY 2: ALLOW easypj → postgres (port 5432)
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-easypj-to-postgres
  namespace: easypj-prod
spec:
  podSelector:
    matchLabels:
      app: postgres             # Applies to postgres pods
  policyTypes:
  - Ingress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app: easypj           # Only easypj pods can reach postgres
    ports:
    - protocol: TCP
      port: 5432

---
# ============================================================
# POLICY 3: ALLOW easypj → redis (port 6379)
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-easypj-to-redis
  namespace: easypj-prod
spec:
  podSelector:
    matchLabels:
      app: redis
  policyTypes:
  - Ingress
  ingress:
  - from:
    - podSelector:
        matchLabels:
          app: easypj
    ports:
    - protocol: TCP
      port: 6379

---
# ============================================================
# POLICY 4: ALLOW all pods → kube-dns (port 53, UDP+TCP)
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-dns
  namespace: easypj-prod
spec:
  podSelector: {}
  policyTypes:
  - Egress
  egress:
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: kube-system
      podSelector:
        matchLabels:
          k8s-app: kube-dns
    ports:
    - protocol: UDP
      port: 53
    - protocol: TCP
      port: 53

---
# ============================================================
# POLICY 5: ALLOW monitoring → all pods (metrics scraping)
# ============================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: allow-monitoring
  namespace: easypj-prod
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          name: monitoring
    ports:
    - protocol: TCP
      port: 9090          # Prometheus metrics port</code></pre>
                </div>

