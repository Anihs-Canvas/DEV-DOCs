    ports:
    - protocol: TCP
      port: 5432
  # Allow redis (required for cache)
  - to:
    - podSelector:
        matchLabels:
          app: redis
    ports:
    - protocol: TCP
      port: 6379
  # ❌ NO external internet access — blocks C2 communication
  # ❌ NO cross-namespace access
  # ❌ NO access to Kubernetes API</code></pre>
