                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">Bash — Generate and attach SLSA provenance in CI/CD</span>
                    </div>
                    <pre><code class="language-bash"># ═══════════════════════════════════════════════════════════════
# Step 1: Generate SLSA provenance predicate (JSON)
# ═══════════════════════════════════════════════════════════════
cat > slsa-provenance.json << 'EOF'
{
  "builder": {
    "id": "https://github.com/easysj/easypj/.github/workflows/build.yml@refs/heads/main"
  },
  "buildType": "https://github.com/actions/runner@v1",
  "invocation": {
    "configSource": {
      "uri": "git+https://github.com/easysj/easypj",
      "digest": {"sha1": "${{ github.sha }}"},
      "entryPoint": ".github/workflows/build.yml"
    }
  },
  "materials": [
    {
      "uri": "git+https://github.com/easysj/easypj",
      "digest": {"sha1": "${{ github.sha }}"}
    }
  ]
}
EOF

# ═══════════════════════════════════════════════════════════════
# Step 2: Sign and attach SLSA provenance as in-toto attestation
# ═══════════════════════════════════════════════════════════════
cosign attest --key cosign.key \
  --predicate slsa-provenance.json \
  --type slsaprovenance \
  registry.easypj.com/easypj:${{ github.sha }}

# ═══════════════════════════════════════════════════════════════
# Step 3: Verify SLSA attestation (in Kyverno or locally)
# ═══════════════════════════════════════════════════════════════
cosign verify-attestation --key cosign.pub \
  --type slsaprovenance \
  registry.easypj.com/easypj:${{ github.sha }}</code></pre>
