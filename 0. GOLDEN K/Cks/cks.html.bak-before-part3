                <h4>CI/CD Integration — GitHub Actions Pipeline with Trivy Gate</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — GitHub Actions workflow: Build → Scan → Deploy (scan gate blocks deployment)</span>
                    </div>
                    <pre><code class="language-yaml">name: easypj CI/CD with Trivy Scan Gate

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build-and-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # ── Build the Docker image ──
      - name: Build easypj image
        run: docker build -t easypj:${{ github.sha }} .

      # ── TRIVY SCAN GATE ──
      # This is the SECURITY GATE: if CRITICAL CVEs are found,
      # the pipeline FAILS and the image NEVER gets pushed.
      - name: Trivy vulnerability scan
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: easypj:${{ github.sha }}
          format: table
          exit-code: 1           # FAIL on CRITICAL/HIGH
          severity: CRITICAL,HIGH
          timeout: 10m

      # ── Only runs if Trivy passes ──
      - name: Tag and push to registry
        if: success()           # Only push if Trivy passed
        run: |
          docker tag easypj:${{ github.sha }} registry.easypj.com/easypj:${{ github.sha }}
          docker push registry.easypj.com/easypj:${{ github.sha }}

      # ── Upload scan results as artifact (for audit trail) ──
      - name: Generate SARIF report
        if: always()            # Generate report even if scan fails
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: easypj:${{ github.sha }}
          format: sarif
          output: trivy-results.sarif
          severity: CRITICAL,HIGH

      - name: Upload scan results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: trivy-scan-results
          path: trivy-results.sarif</code></pre>
