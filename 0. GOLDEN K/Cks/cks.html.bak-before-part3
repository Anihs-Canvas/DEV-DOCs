                <h4>Task B: Create Audit Policy, Enable Audit Logging, Verify Log Output</h4>
                <div class="scenario-box">
                    <div class="scenario-header"><span class="scenario-badge info">TASK</span><span class="scenario-title">Context: mk8s-cluster-2 | Time: 8 min | Points: 6</span></div>
                    <div class="scenario-steps">
                        <div class="scenario-step"><div class="step-marker">📋</div><div class="step-content"><strong>Objective:</strong> Create an audit policy that logs all Secret reads at Metadata level. Enable audit logging. Create and read a Secret to verify logs are generated.</div></div>
                    </div>
                </div>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-lang">✅ Solution</span></div>
                    <pre><code class="language-bash"># Step 1: Create audit policy file on control plane node
sudo mkdir -p /etc/kubernetes/audit
sudo tee /etc/kubernetes/audit/policy.yaml &lt;&lt;EOF
apiVersion: audit.k8s.io/v1
kind: Policy
rules:
- level: Metadata
  resources:
  - group: ""
    resources: ["secrets"]
EOF

# Step 2: Edit API server manifest to enable audit logging
sudo vi /etc/kubernetes/manifests/kube-apiserver.yaml
# ADD these flags:
#   - --audit-policy-file=/etc/kubernetes/audit/policy.yaml
#   - --audit-log-path=/var/log/kubernetes/audit.log
#   - --audit-log-maxage=7
#   - --audit-log-maxbackup=3
#   - --audit-log-maxsize=100

# ADD volumeMounts:
#   - mountPath: /etc/kubernetes/audit
#     name: audit-policy
#     readOnly: true
#   - mountPath: /var/log/kubernetes
#     name: audit-log
#     readOnly: false

# ADD volumes:
#   - name: audit-policy
#     hostPath:
#       path: /etc/kubernetes/audit
#       type: DirectoryOrCreate
#   - name: audit-log
#     hostPath:
#       path: /var/log/kubernetes
#       type: DirectoryOrCreate

# Step 3: Wait for API server restart, then test
kubectl create secret generic test-audit --from-literal=key=secretvalue -n default
kubectl get secret test-audit -n default -o yaml > /dev/null

# Step 4: Verify audit log contains the secret read
sudo cat /var/log/kubernetes/audit.log | jq 'select(.objectRef.resource=="secrets") | {verb, user: .user.username, secret: .objectRef.name, time: .stageTimestamp}'
# Should show: {"verb":"get","user":"kubernetes-admin","secret":"test-audit","time":"..."}</code></pre>
