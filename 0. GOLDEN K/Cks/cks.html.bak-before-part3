                <h4>Gap 2: Falco Missed Python-Based DB Dump → Add Comprehensive DB Rules</h4>
                <div class="code-block-wrapper">
                    <div class="code-block-header">
                        <span class="code-lang">YAML — Updated Falco rules: Detect Python DB access + reverse shells</span>
                    </div>
                    <pre><code class="language-yaml"># /etc/falco/falco_rules.local.yaml — POST-INCIDENT UPDATE

# NEW Rule: Alert on ANY exec to easypj container (shell or otherwise)
- rule: ANY exec in easypj container
  desc: "Any new process in easypj container is suspicious. Django should only run gunicorn workers."
  condition: >
    spawned_process
    and container.name startswith "easypj"
    and not proc.name in (gunicorn, python3)
    # python3 is the gunicorn worker parent — but ANY other process is suspect
  output: >
    🚨 UNEXPECTED PROCESS in easypj! pod=%pod.name proc=%proc.name
    cmdline=%proc.cmdline
  priority: CRITICAL
  tags: [easypj, post-incident]

# NEW Rule: Detect Python script making database connections
- rule: Python database access in easypj
  desc: "Python process importing database libraries — possible data exfiltration."
  condition: >
    spawned_process
    and container.name startswith "easypj"
    and proc.name = python3
    and (proc.args contains "psycopg2"
         or proc.args contains "sqlite3"
         or proc.args contains "MySQLdb"
         or proc.args contains "pymongo")
  output: >
    💾 PYTHON DB ACCESS in easypj! pod=%pod.name args=%proc.args
  priority: CRITICAL
  tags: [easypj, database, post-incident]

# NEW Rule: Detect reverse shell patterns
- rule: Reverse shell detected
  desc: "Process with redirected stdin/stdout to a socket — classic reverse shell."
  condition: >
    spawned_process
    and container.name startswith "easypj"
    and proc.name in (bash, sh, zsh)
    and (proc.args contains "/dev/tcp"
         or proc.args contains "socket.socket"
         or proc.args contains "dup2")
  output: >
    🐚 REVERSE SHELL in easypj! pod=%pod.name cmdline=%proc.cmdline
  priority: CRITICAL
  tags: [easypj, network, reverse-shell, post-incident]</code></pre>
