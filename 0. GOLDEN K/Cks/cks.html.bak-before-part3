  │  kubectl apply -f constraint-template.yaml         # Deploy Gatekeeper      │
  │  kubectl apply -f constraint.yaml                  # Deploy constraint       │
  ├────────────────────────────────────────────────────────────────────────────┤
  │  DOMAIN 6: MONITORING, LOGGING & RUNTIME SECURITY (20%)                     │
  │  ──────────────────────────────────────────────────────                      │
  │  vi /etc/falco/falco_rules.local.yaml              # Custom Falco rules      │
  │  falco --validate /etc/falco/falco_rules.local.yaml # Validate rules        │
  │  kill -1 $(pidof falco)                            # Graceful reload         │
  │  kubectl logs -n falco -l app=falco -f             # Follow Falco logs      │
  │  cat /var/log/kubernetes/audit.log | jq .          # Read audit log         │
  │  cat /var/log/kubernetes/audit.log | jq 'select(.objectRef.resource=="secrets")' │
  └────────────────────────────────────────────────────────────────────────────┘
</pre>
