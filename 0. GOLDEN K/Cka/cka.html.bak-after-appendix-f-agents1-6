                                <td>Mesh overlay</td>
                                <td>✅ Basic</td>
                                <td>⭐⭐⭐☆☆</td>
                                <td>Easy setup, small clusters</td>
                            </tr>
                            <tr>
                                <td><strong>Canal</strong></td>
