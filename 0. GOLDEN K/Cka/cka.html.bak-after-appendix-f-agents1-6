kind: PodDisruptionBudget
metadata:
  name: easypj-pdb
  namespace: default
spec:
  minAvailable: 2              <span class="comment"># At least 2 pods must always be running</span>
  selector:
    matchLabels:
      app: easypj              <span class="comment"># Must match the Deployment's pod labels</span></code></pre>
