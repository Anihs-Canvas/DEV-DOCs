kubectl auth can-i get pods --as=system:serviceaccount:easypj:easypj-sa -n easypj
<span class="comment"># no</span>

<span class="comment"># 2. Check existing roles/bindings</span>
kubectl get roles,rolebindings -n easypj
kubectl get clusterroles,clusterrolebindings | grep easypj

<span class="comment"># 3. Fix: create the missing Role + RoleBinding</span>
kubectl create role easypj-role --verb=get,list,watch --resource=pods -n easypj
kubectl create rolebinding easypj-binding --role=easypj-role \
  --serviceaccount=easypj:easypj-sa -n easypj

<span class="comment"># 4. Verify</span>
kubectl auth can-i get pods --as=system:serviceaccount:easypj:easypj-sa -n easypj
<span class="comment"># yes</span></code></pre>
