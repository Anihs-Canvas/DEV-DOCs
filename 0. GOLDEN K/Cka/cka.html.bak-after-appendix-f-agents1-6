kind: Pod
metadata:
  name: my-pod
spec:
  containers:
  - name: app
    image: nginx
    volumeMounts:                    # ◀── WHERE to mount
    - name: my-vol
      mountPath: /data               # ◀── path inside container
      readOnly: false                 # ◀── optional
  volumes:                           # ◀── WHAT to mount
  - name: my-vol                     # ◀── must match volumeMounts.name
    emptyDir: {}                     # ◀── volume type
    <span class="comment"># OR: hostPath: { path: /host/path, type: Directory }</span>
    <span class="comment"># OR: persistentVolumeClaim: { claimName: my-pvc }</span>
    <span class="comment"># OR: configMap: { name: my-cm }</span>
