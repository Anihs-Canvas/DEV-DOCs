              httpGet: { path: /healthz/, port: 8000 }
              initialDelaySeconds: 5
              periodSeconds: 10
            livenessProbe:
              httpGet: { path: /healthz/, port: 8000 }
              initialDelaySeconds: 15
              periodSeconds: 20</code></pre>
