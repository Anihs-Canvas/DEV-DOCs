                            <pre><code class="language-bash"><span class="comment"># Method 1: Field selector (recommended)</span>
kubectl get pods -A --field-selector spec.nodeName=worker-1
<span class="comment"># NAMESPACE     NAME              READY  STATUS</span>
<span class="comment"># default       web-abc12         1/1    Running</span>
<span class="comment"># kube-system   kube-proxy-xyz    1/1    Running</span>
