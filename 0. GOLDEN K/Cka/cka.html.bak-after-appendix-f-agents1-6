            <div class="diagram-container">
                <h4>Pod Spec Structure — Visual Map</h4>
                <div class="diagram-box">
                    <pre>
  Pod
   ├── metadata
   │    ├── name: easypj-web
   │    ├── namespace: easypj
   │    └── labels: {app: easypj}
   │
   └── spec
        ├── securityContext: {runAsNonRoot, runAsUser, fsGroup}   ← POD-level default
        ├── serviceAccountName: easypj-sa
