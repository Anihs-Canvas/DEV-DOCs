<pre><code class="language-bash">k apply -f postgres-statefulset.yaml
k get statefulset postgres -n easypj-production          <span class="comment"># READY 1/1</span>
k get pvc -n easypj-production                            <span class="comment"># data-postgres-0  Bound</span>
k get pod postgres-0 -n easypj-production -o wide          <span class="comment"># Running, READY 1/1</span></code></pre>
