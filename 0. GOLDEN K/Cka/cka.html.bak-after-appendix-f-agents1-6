<pre><code class="language-bash"># ═══ INSTALL METRICS SERVER ═══
<span class="comment"># Download and apply the official manifest</span>
kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

<span class="comment"># For local clusters (kubeadm, kind, minikube) — add insecure TLS flag:</span>
<span class="comment"># Edit the Deployment and add to args:</span>
<span class="comment"># --kubelet-insecure-tls</span>
kubectl edit deployment metrics-server -n kube-system

<span class="comment"># Verify metrics server is running</span>
kubectl get pods -n kube-system | grep metrics-server
kubectl get apiservices | grep metrics     <span class="comment"># Should show v1beta1.metrics.k8s.io</span>

<span class="comment"># ═══ KUBECTL TOP — RESOURCE USAGE ═══</span>
<span class="comment"># Node-level metrics</span>
kubectl top nodes                          <span class="comment"># CPU and memory per node</span>
kubectl top nodes --sort-by=cpu            <span class="comment"># Sort by CPU usage</span>

<span class="comment"># Pod-level metrics</span>
kubectl top pods                           <span class="comment"># CPU and memory per pod</span>
kubectl top pods -A                        <span class="comment"># All namespaces</span>
kubectl top pods --sort-by=memory          <span class="comment"># Sort by memory usage</span>
kubectl top pods --sort-by=cpu             <span class="comment"># Sort by CPU usage</span>
kubectl top pods -n kube-system            <span class="comment"># Specific namespace</span>

<span class="comment"># Pod with containers breakdown</span>
kubectl top pods --containers              <span class="comment"># Per-container metrics</span></code></pre>
