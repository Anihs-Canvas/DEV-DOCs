<span class="comment"># CrashLoopBackOff</span>
kubectl logs -n kube-system -l k8s-app=kube-dns
<span class="comment"># "Loop (127.0.0.1:xxxxx -&gt; :53) detected for zone '.'"</span>

kubectl apply -f coredns-backup.yaml
kubectl delete pods -n kube-system -l k8s-app=kube-dns
<span class="comment"># pods come back Running; DNS recovers</span></code></pre>
