apiVersion: v1
kind: ConfigMap
metadata:
  name: app-config
data:
  APP_ENV: production              # ◀── key-value pair
  config.properties: |             # ◀── multi-line file content
    server.port=8080
    log.level=INFO
---
<span class="comment"># Secret</span>
apiVersion: v1
kind: Secret
metadata:
  name: app-secret
type: Opaque
data:
  DB_PASS: cGFzc3dvcmQxMjM=       # ◀── base64 encoded
stringData:
  API_KEY: my-plain-text-key       # ◀── auto-encoded at creation
---
<span class="comment"># Pod — env var injection</span>
apiVersion: v1
kind: Pod
metadata:
  name: app-pod
spec:
  containers:
  - name: app
    image: nginx
    envFrom:                       # ◀── inject ALL keys as env vars
    - configMapRef:
        name: app-config
    env:
    - name: DB_PASSWORD            # ◀── inject SINGLE key
      valueFrom:
        secretKeyRef:
          name: app-secret
