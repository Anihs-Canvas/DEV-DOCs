<span class="comment"># Step 2: Update repositories and install target version</span>
apt-get update && apt-get install -y kubeadm=1.31.0-1.1

<span class="comment"># Step 3: Hold kubeadm again to prevent accidental updates</span>
apt-mark hold kubeadm

<span class="comment"># Verify kubeadm version</span>
kubeadm version</code></pre>
