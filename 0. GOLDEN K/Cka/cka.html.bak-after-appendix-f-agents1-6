kind: HorizontalPodAutoscaler
metadata:
  name: easypj-web-hpa
  namespace: easypj
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: easypj-web
  minReplicas: 3            <span class="comment"># Minimum for HA</span>
  maxReplicas: 20           <span class="comment"># Max pods — budget limit</span>
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70   <span class="comment"># Scale when CPU > 70%</span>
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80   <span class="comment"># Also scale on memory pressure</span>
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 60    <span class="comment"># Wait 1 min before scaling up</span>
      policies:
      - type: Pods
        value: 4
        periodSeconds: 60               <span class="comment"># Add max 4 pods per minute</span>
    scaleDown:
      stabilizationWindowSeconds: 300   <span class="comment"># Wait 5 min before scaling down</span>
      policies:
      - type: Percent
