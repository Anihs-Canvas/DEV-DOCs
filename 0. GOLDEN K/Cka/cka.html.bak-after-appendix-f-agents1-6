<pre><code class="language-yaml"><span class="comment"># ObjectType — Deployment: jobpost app tier, wired to Secret+ConfigMap, with probes</span>
        spec:
          containers:
          - name: jobpost
            image: easypj/jobpost:v1
            ports: [{ containerPort: 8000 }]
            envFrom:
            - configMapRef: { name: jobpost-config }
            - secretRef: { name: jobpost-secrets }
