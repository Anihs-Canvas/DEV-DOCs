<pre><code class="language-bash">kubectl create deployment easypj-web --image=easypj:v1 $do &gt; d.yaml
vim d.yaml                                  <span class="comment"># introduce the bug</span>
kubectl apply -f d.yaml --dry-run=server    <span class="comment"># → error (selector mismatch / parse)</span>
vim d.yaml                                  <span class="comment"># fix: selector == template labels</span>
