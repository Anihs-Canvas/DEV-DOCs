<pre><code class="language-bash">k apply -f jobpost-web.yaml
k get pods -n easypj-production -l app=jobpost-web    <span class="comment"># 2/2 Running once probes pass</span>
k exec -n easypj-production deploy/jobpost-web -- env | grep DATABASE_URL</code></pre>
