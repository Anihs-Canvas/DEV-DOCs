grep data-dir /etc/kubernetes/manifests/etcd.yaml
<span class="comment"># --data-dir=/var/lib/etcd</span>

<span class="comment"># Method 2: From running pod</span>
kubectl describe pod etcd-controlplane -n kube-system | \
grep data-dir
<span class="comment"># --data-dir=/var/lib/etcd</span>

<span class="comment"># Method 3: From process</span>
ps aux | grep etcd | grep -oP 'data-dir=\S+'
<span class="comment"># data-dir=/var/lib/etcd</span>

<span class="comment"># Method 4: From etcd pod volumes</span>
kubectl get pod etcd-controlplane -n kube-system \
