systemctl daemon-reload && systemctl restart kubelet
exit
kubectl uncordon cp-3

<span class="comment"># ══════════ worker01 — same "node" procedure, one worker at a time ══════════</span>
kubectl drain worker01 --ignore-daemonsets --delete-emptydir-data
ssh worker01
apt-mark unhold kubeadm && apt-get update && apt-get install -y kubeadm=1.31.0-1.1 && apt-mark hold kubeadm
kubeadm upgrade node
