kubectl delete mutatingwebhookconfiguration easypj-injector
kubectl -n easypj-system get pods    <span class="comment"># find & fix the crashed backing pod</span>
<span class="comment"># redeploy the webhook config once the pod is healthy again</span></code></pre>
