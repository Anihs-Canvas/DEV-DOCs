kubectl get pods -n easypj -l app=easypj-spread -o wide
<span class="comment"># NAME                     NODE      STATUS</span>
<span class="comment"># easypj-spread-abc12      node-1    Running</span>
<span class="comment"># easypj-spread-def34      node-2    Running</span>
<span class="comment"># easypj-spread-ghi56      node-3    Running</span>
