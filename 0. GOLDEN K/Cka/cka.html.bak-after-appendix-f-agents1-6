                                <span class="code-dot green"></span>
                            <span class="code-lang">pdb-skeleton.yaml</span>
                        </div>
                        <pre><code class="language-yaml">apiVersion: policy/v1                    # ← Always policy/v1 (not policy/v1beta1)
kind: PodDisruptionBudget
metadata:
  name: &lt;pdb-name&gt;
  namespace: &lt;namespace&gt;
spec:
  <span class="comment"># Choose ONE of these (not both):</span>
  minAvailable: &lt;number-or-percent&gt;      <span class="comment"># At least N pods must be running</span>
  <span class="comment"># maxUnavailable: &lt;number-or-percent&gt;  # At most N pods can be down</span>
