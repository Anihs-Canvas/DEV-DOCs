                    <div class="drill-solution">
                        <details>
                            <summary>View Solution</summary>
                            <pre><code class="language-bash"><span class="comment"># Step 1: Namespace</span>
kubectl create namespace easypj-drill

<span class="comment"># Step 2: ServiceAccount</span>
kubectl create sa easypj-web-sa -n easypj-drill

<span class="comment"># Step 3: Least-privilege Role</span>
kubectl create role easypj-web-role \
  --verb=get,list,watch --resource=configmaps \
  -n easypj-drill
kubectl create role easypj-web-role \
  --verb=get,list,watch --resource=configmaps \
  --dry-run=client -o yaml | \
  kubectl apply -f - -n easypj-drill
<span class="comment"># Add secrets: get via edit, or write the YAML directly:</span>
cat <<EOF | kubectl apply -f -
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: easypj-web-role
  namespace: easypj-drill
rules:
- apiGroups: [""]
  resources: ["configmaps"]
  verbs: ["get", "list", "watch"]
- apiGroups: [""]
  resources: ["secrets"]
  verbs: ["get"]
EOF

<span class="comment"># Step 4: RoleBinding</span>
kubectl create rolebinding easypj-web-binding \
  --role=easypj-web-role \
  --serviceaccount=easypj-drill:easypj-web-sa \
  -n easypj-drill

<span class="comment"># Step 5: Verify BEFORE creating the pod</span>
kubectl auth can-i get configmaps \
  --as=system:serviceaccount:easypj-drill:easypj-web-sa -n easypj-drill   <span class="comment"># yes</span>
kubectl auth can-i get secrets \
  --as=system:serviceaccount:easypj-drill:easypj-web-sa -n easypj-drill   <span class="comment"># yes</span>
kubectl auth can-i list pods \
  --as=system:serviceaccount:easypj-drill:easypj-web-sa -n easypj-drill   <span class="comment"># no</span>
kubectl auth can-i delete secrets \
  --as=system:serviceaccount:easypj-drill:easypj-web-sa -n easypj-drill   <span class="comment"># no</span>

<span class="comment"># Step 6: Run the pod with this SA</span>
kubectl run easypj-web-drill --image=easypj:latest \
  -n easypj-drill \
  --overrides='{"spec":{"serviceAccountName":"easypj-web-sa"}}'

<span class="comment"># Step 7: Short-lived token, decode claims</span>
TOKEN=$(kubectl create token easypj-web-sa -n easypj-drill --duration=300s)
echo $TOKEN | cut -d. -f2 | base64 -d 2>/dev/null | jq '{sub, aud, exp, iat}'
<span class="comment"># {</span>
<span class="comment">#   "sub": "system:serviceaccount:easypj-drill:easypj-web-sa",</span>
<span class="comment">#   "aud": ["https://kubernetes.default.svc"],</span>
<span class="comment">#   "exp": 1700000300,</span>
<span class="comment">#   "iat": 1700000000</span>
<span class="comment"># }</span></code></pre>
