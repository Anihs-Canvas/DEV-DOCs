<span class="comment"># At least 3 control plane nodes (odd number for quorum)</span>

<span class="comment"># 2. etcd Cluster Health</span>
ETCDCTL_API=3 etcdctl endpoint health --cluster \
--cacert=... --cert=... --key=...
<span class="comment"># All members healthy, leader elected</span>

<span class="comment"># 3. Load Balancer</span>
curl -k https://&lt;lb-endpoint&gt;:6443/healthz
<span class="comment"># ok — LB routing to healthy API servers</span>

<span class="comment"># 4. Automated etcd Backups</span>
