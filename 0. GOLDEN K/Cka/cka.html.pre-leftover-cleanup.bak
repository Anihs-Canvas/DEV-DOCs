            </div>


            <div class="cka-imperative-ref">
                <h4>Cluster Upgrade Commands</h4>
                <table>
                    <thead>
                        <tr><th>Action</th><th>Command</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Check current version</td><td><code>kubectl get nodes</code></td></tr>
                        <tr><td>Unhold kubeadm</td><td><code>apt-mark unhold kubeadm</code></td></tr>
                        <tr><td>Install specific kubeadm</td><td><code>apt-get install -y kubeadm=1.31.0-1.1</code></td></tr>
                        <tr><td>Hold kubeadm</td><td><code>apt-mark hold kubeadm</code></td></tr>
                        <tr><td>Check upgrade plan</td><td><code>kubeadm upgrade plan</code></td></tr>
                        <tr><td>Apply upgrade (control plane)</td><td><code>kubeadm upgrade apply v1.31.0</code></td></tr>
                        <tr><td>Upgrade worker node config</td><td><code>kubeadm upgrade node</code></td></tr>
                        <tr><td>Drain node</td><td><code>kubectl drain NODE --ignore-daemonsets</code></td></tr>
                        <tr><td>Upgrade kubelet + kubectl</td><td><code>apt-get install -y kubelet=1.31.0-1.1 kubectl=1.31.0-1.1</code></td></tr>
                        <tr><td>Restart kubelet</td><td><code>systemctl daemon-reload && systemctl restart kubelet</code></td></tr>
                        <tr><td>Uncordon node</td><td><code>kubectl uncordon NODE</code></td></tr>
                    </tbody>
                </table>
            </div>


            <div class="cka-kubectl-path">
                <h4>Find Upgrade Info Fast</h4>
                <pre><code>kubectl get nodes                          <span class="comment"># current versions</span>
kubeadm version                             <span class="comment"># kubeadm version</span>
kubelet --version                           <span class="comment"># kubelet version</span>
kubeadm upgrade plan                        <span class="comment"># available upgrades</span>
apt-cache madison kubeadm                   <span class="comment"># available package versions</span></code></pre>
            </div>

