            </div>

            <!-- ─────────── SECTION TOC ─────────── -->
            <div class="chapter-placeholder">
                <h4>🗂️ Section TOC</h4>
                <p>A jump-table of this chapter's sections goes here.</p>
            </div>


            <!-- ═══ Chapter 40 Policy Types Overview ═══ -->
            <div class="card-grid cols-4">
                <div class="info-card highlight">
                    <div class="card-icon-lg">🛡️</div>
                    <h5>Pod Security</h5>
                    <p>Three-level standard (privileged, baseline, restricted) via namespace labels</p>
                </div>
                <div class="info-card">
                    <div class="card-icon-lg">📏</div>
                    <h5>LimitRange</h5>
                    <p>Per-pod defaults and bounds — min, max, default CPU/memory for individual containers</p>
                </div>
                <div class="info-card">
                    <div class="card-icon-lg">📊</div>
                    <h5>ResourceQuota</h5>
                    <p>Namespace-wide totals — cap aggregate resource consumption across all pods</p>
                </div>
                <div class="info-card">
                    <div class="card-icon-lg">🌐</div>
                    <h5>NetworkPolicy</h5>
                    <p>Ingress/egress traffic rules — default-deny + allow-list per namespace</p>
                </div>
            </div>

            <div class="flow-diagram">
                <div class="flow-step"><span class="flow-icon">🛡️</span><span>PSA Labels</span></div>
                <div class="flow-arrow">→</div>
                <div class="flow-step"><span class="flow-icon">📏</span><span>LimitRange</span></div>
                <div class="flow-arrow">→</div>
                <div class="flow-step"><span class="flow-icon">📊</span><span>Quota Check</span></div>
                <div class="flow-arrow">→</div>
                <div class="flow-step"><span class="flow-icon">🌐</span><span>NetPolicy</span></div>
