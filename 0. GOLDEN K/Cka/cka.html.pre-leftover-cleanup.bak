                <h4>🗂️ Section TOC</h4>
                <p>A jump-table of this chapter's sections goes here.</p>
            </div>


            <!-- CKA Exam Tip -->


            <!-- Imperative Reference -->
            <div class="cka-imperative-ref">
                <h4>⌨️ Node Maintenance Command Reference</h4>
                <table>
                    <thead>
                        <tr><th>Action</th><th>Command</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Drain node</td><td><code>kubectl drain &lt;node&gt; --ignore-daemonsets --delete-emptydir-data</code></td></tr>
                        <tr><td>Cordon node</td><td><code>kubectl cordon &lt;node&gt;</code></td></tr>
                        <tr><td>Uncordon node</td><td><code>kubectl uncordon &lt;node&gt;</code></td></tr>
