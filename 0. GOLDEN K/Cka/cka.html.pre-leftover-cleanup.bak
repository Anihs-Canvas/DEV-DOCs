<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CKA — Certified Kubernetes Administrator · The Complete Mastery Guide (Edition 2)</title>
    <meta name="description" content="The complete, self-contained CKA guide — exam AND beyond — taught on the easypj/jobpost Django project. Aligned to the 2025 syllabus.">
    <!-- Prism.js for syntax highlighting (lazy) -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css"></noscript>
    <style>
        /* ============================================
           BASE / THEME (reused from cka_1, augmented)
           ============================================ */
        :root{
            --bg:#0d1117; --panel:#161b22; --panel-2:#21262d; --border:#30363d;
            --k8s:#326ce5; --accent:#60a5fa; --accent-2:#93c5fd; --text:#e4e4e7;
            --muted:#a1a1aa; --green:#4ade80; --yellow:#facc15; --red:#f87171;
            --sidebar-w:340px;
        }
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
            line-height: 1.6; margin: 0; padding: 0; color: var(--text); background: var(--bg);
        }
        a { color: var(--accent); }

        /* Dark scrollbars */
        *::-webkit-scrollbar { width: 12px; height: 12px; }
        *::-webkit-scrollbar-track { background: var(--panel-2); }
        *::-webkit-scrollbar-thumb { background: #484f58; border-radius: 6px; border: 2px solid var(--panel-2); }
        *::-webkit-scrollbar-thumb:hover { background: #6e7681; }
        * { scrollbar-width: thin; scrollbar-color: #484f58 var(--panel-2); }

        /* ============================================
           HEADER
           ============================================ */
        header {
            background: linear-gradient(135deg, #1e3a5f 0%, #0f2744 60%, #0a1929 100%);
            color: var(--text); padding: 50px 20px; text-align: center;
            box-shadow: 0 6px 18px rgba(0,0,0,0.4); border-bottom: 3px solid var(--k8s);
            position: relative; overflow: hidden;
        }
        header::before {
            content: "☸"; position: absolute; font-size: 300px; opacity: 0.04;
            right: -50px; top: -80px; pointer-events: none;
        }
        header .eyebrow {
            display:inline-block; margin:0 0 14px; padding:4px 14px; border-radius:20px;
            font-size:12px; letter-spacing:2px; text-transform:uppercase; font-weight:700;
            color:var(--accent-2); background:rgba(50,108,229,.25); border:1px solid rgba(50,108,229,.5);
        }
        header h1 {
            margin: 0 0 16px 0; font-size: 2.8em; font-weight: 700; line-height:1.15;
            background: linear-gradient(135deg, #60a5fa 0%, #93c5fd 50%, #60a5fa 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        header .subtitle { margin: 0 0 8px 0; font-size: 1.3em; opacity: 0.92; color: var(--accent-2); }
        header .description { margin: 0 auto 24px; font-size: 1.08em; opacity: 0.82; max-width: 820px; }
        .header-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
        .tag {
            display: inline-block; background: rgba(50, 108, 229, 0.3); color: var(--accent-2);
            border: 1px solid rgba(50, 108, 229, 0.5); border-radius: 20px; padding: 6px 16px;
            font-size: 13px; font-weight: 500;
        }
        .tag.beginner { background: rgba(34, 197, 94, 0.2); border-color: rgba(34, 197, 94, 0.5); color: var(--green); }
        .tag.exam { background: rgba(234, 179, 8, 0.18); border-color: rgba(234,179,8,.5); color: var(--yellow); }

        /* ============================================
           SIDEBAR TOC (reused from cka_1)
           ============================================ */
        .toc-sidebar {
            position: fixed; top: 0; left: 0; height: 100vh; width: var(--sidebar-w);
            background: var(--panel); border-right: 1px solid var(--border);
            box-shadow: 0 0 24px rgba(0,0,0,0.4); padding: 16px 0; overflow-y: auto;
            transform: translateX(-100%); transition: transform 250ms ease; z-index: 1000;
        }
        .sidebar-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 16px 16px; border-bottom: 1px solid var(--border); margin-bottom: 12px;
        }
        .sidebar-header h2 { margin: 0; font-size: 18px; color: var(--accent); font-weight: 700; }
        .sidebar-controls { display: flex; gap: 6px; }
        .expand-collapse-btn {
            background: #1e3a5f; color: var(--accent-2); border: 1px solid var(--k8s);
            border-radius: 4px; padding: 4px 10px; cursor: pointer; font-size: 14px; transition: all 0.2s ease;
        }
        .expand-collapse-btn:hover { background: var(--k8s); color: #fff; }
        .toc-list { list-style: none; padding: 0 12px; margin: 0; }
        .toc-list > li { margin-bottom: 4px; }

        .part-header {
            background: linear-gradient(135deg, #1e3a5f 0%, #0f2744 100%);
            border: 1px solid var(--k8s); border-radius: 8px; padding: 10px 14px;
            margin: 16px 0 8px 0; cursor: pointer; transition: all 0.2s ease;
        }
        .part-header:first-child { margin-top: 0; }
        .part-header:hover { background: linear-gradient(135deg, #326ce5 0%, #1e3a5f 100%); }
        .part-header .part-title {
            color: var(--accent-2); font-weight: 600; font-size: 14px;
            display: flex; align-items: center; justify-content: space-between; gap:8px;
        }
        .part-header .part-badge { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(50, 108, 229, 0.3); white-space:nowrap; }
        .part-badge.beginner { background: rgba(34, 197, 94, 0.3); color: var(--green); }
        .part-badge.intermediate { background: rgba(234, 179, 8, 0.3); color: var(--yellow); }
        .part-badge.advanced { background: rgba(239, 68, 68, 0.3); color: var(--red); }

        .chapter-list { list-style: none; padding-left: 12px; margin: 8px 0; display: none; }
        .chapter-list.visible { display: block; }
        .chapter-item { margin: 4px 0; }
        .chapter-link {
            display: flex; align-items: center; justify-content: flex-start; padding: 8px 12px;
            text-align: left; color: var(--text); text-decoration: none; border-radius: 6px;
            font-size: 13px; transition: all 0.2s ease; border-left: 3px solid transparent;
        }
        .chapter-link:hover { background: var(--panel-2); border-left-color: var(--k8s); color: var(--accent); }
        .chapter-link.active { background: #1e3a5f; border-left-color: var(--k8s); color: var(--accent); font-weight: 600; }
        .chapter-number { font-size: 11px; color: var(--muted); margin-right: 8px; min-width: 32px; }
        .chapter-row { display: flex; align-items: center; justify-content: space-between; gap: 4px; }
        .chapter-row .chapter-link { flex: 1; }
        .section-toggle-btn {
            background: none; border: none; color: var(--muted); cursor: pointer; font-size: 12px;
            padding: 2px 6px; border-radius: 4px;
        }
        .section-toggle-btn:hover { background: var(--border); color: var(--accent); }

        .sub-toc { list-style: none; padding-left: 20px; margin: 4px 0; display: none; }
        .sub-toc.visible { display: block; }
        .sub-toc li { margin: 2px 0; }
        .sub-toc a { color: var(--muted); text-decoration: none; font-size: 12px; padding: 4px 8px; display: block; border-radius: 4px; }
        .sub-toc a:hover { color: var(--accent); background: var(--panel-2); }

        /* Sub-sub-sections (4th level — for sections that have their own sub-points) */
        .sub-toc li.has-children > a { display: inline; }
        .sub-toc li.has-children { position: relative; }
        .sub-sub-toggle { background: none; border: none; color: #6b7280; cursor: pointer; font-size: 10px; padding: 2px 4px; margin-left: 2px; vertical-align: middle; }
        .sub-sub-toggle:hover { color: var(--accent); }
        .sub-sub-toc { list-style: none; padding-left: 16px; margin: 2px 0 4px 0; display: none; }
        .sub-sub-toc.visible { display: block; }
        .sub-sub-toc li { margin: 1px 0; }
        .sub-sub-toc a { color: #8b8b8b; text-decoration: none; font-size: 11px; padding: 2px 6px; display: block; border-radius: 3px; border-left: 2px solid var(--border); }
        .sub-sub-toc a:hover { color: var(--accent); background: #1c2128; border-left-color: var(--k8s); }
        .sub-sub-toc a.active { color: var(--accent); border-left-color: var(--k8s); }

        /* ============================================
           TOGGLE + NAV STATE + RESPONSIVE (augmented)
           ============================================ */
        .toc-toggle {
            position: fixed; top: 18px; left: 18px;
            background: linear-gradient(135deg, #1e3a5f 0%, #326ce5 100%); color: #fff;
            border: 1px solid var(--k8s); border-radius: 8px; padding: 12px 18px; cursor: pointer;
            z-index: 1100; font-size: 15px; font-weight: 600; box-shadow: 0 4px 12px rgba(50,108,229,0.3);
            transition: all 0.2s ease;
        }
        .toc-toggle:hover { background: linear-gradient(135deg,#326ce5 0%,#1e3a5f 100%); transform: scale(1.05); box-shadow: 0 6px 16px rgba(50,108,229,.4); }
        .nav-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.5); opacity: 0; visibility: hidden; transition: opacity .25s ease; z-index: 999; }

        /* default (mobile-first): sidebar is an off-canvas overlay */
        body.nav-open .toc-sidebar { transform: translateX(0); }
        body.nav-open .nav-backdrop { opacity: 1; visibility: visible; }

        /* DESKTOP >=1000px: sidebar pinned, content gets margin; toggle collapses it */
        @media (min-width: 1000px) {
            .toc-sidebar { transform: translateX(0); }
            /* Reserve space for the pinned sidebar with body padding (NOT a fixed
               margin) so <main> can still center via margin:0 auto in the rest. */
            body { padding-left: var(--sidebar-w); transition: padding-left 250ms ease; }
            body.nav-closed .toc-sidebar { transform: translateX(-100%); }
            body.nav-closed { padding-left: 0; }
            .nav-backdrop { display: none; }
            /* toggle stays visible so you can always collapse/expand — just repositions */
            .toc-toggle { left: calc(var(--sidebar-w) + 18px); }   /* beside the open sidebar */
            body.nav-closed .toc-toggle { left: 18px; }            /* corner when collapsed */
        }
        /* TABLET/MOBILE <1000px: sidebar overlays content (no body padding) */
        /* MOBILE <768px: full-width slide-over + 44px touch targets */
        @media (max-width: 767px) {
            .toc-sidebar { width: 100%; }
            .chapter-link, .sub-toc a, .part-header, .toc-toggle, .section-toggle-btn { min-height: 44px; }
            .sub-toc a { display: flex; align-items: center; }
            header { padding: 34px 16px; }
            header h1 { font-size: 2em; }
            main { padding: 24px 14px; }
        }

        /* ============================================
           MAIN + IN-PAGE TOC CARDS (reused from cka_1)
           ============================================ */
        main { padding: 40px 24px; max-width: 1920px; margin: 0 auto; background: var(--bg); }
        .intro-callout {
            background: linear-gradient(135deg, #1a2e1a 0%, #1e3a5f 100%);
            border: 1px solid var(--k8s); border-radius: 12px; padding: 24px 30px; margin: 10px 0 40px 0;
        }
        .intro-callout p { margin: 0 0 10px; font-size: 1.08em; line-height: 1.7; }
        .intro-callout p:last-child { margin-bottom: 0; }
        .intro-callout strong { color: var(--accent); }

        .toc-section { margin: 50px 0; }
        .toc-section > h2 { color: var(--accent); font-size: 1.8em; text-align: center; margin-bottom: 10px; position: relative; }
        .toc-section > h2::after { content: ''; display: block; width: 80px; height: 3px; background: var(--k8s); margin: 12px auto 0; border-radius: 2px; }
        .toc-section .section-lead { text-align:center; color:var(--muted); max-width:760px; margin:0 auto 30px; }

        .toc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; }
        .toc-card {
            background: linear-gradient(135deg, var(--panel-2) 0%, var(--panel) 100%);
            border: 1px solid var(--border); border-radius: 16px; padding: 24px;
            transition: all 0.3s ease; cursor: pointer; position: relative; overflow: hidden;
        }
        .toc-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
            background: linear-gradient(90deg, var(--k8s), var(--accent)); opacity: 0; transition: opacity 0.3s ease;
        }
        .toc-card:hover { background: linear-gradient(135deg, #1e3a5f 0%, var(--panel-2) 100%); border-color: var(--k8s); transform: translateY(-6px); box-shadow: 0 12px 30px rgba(50,108,229,0.2); }
        .toc-card:hover::before { opacity: 1; }
        .toc-card a { text-decoration: none; color: inherit; display: block; }
        .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
        .card-icon { font-size: 2em; }
        .card-part-badge { font-size: 12px; padding: 4px 12px; border-radius: 12px; font-weight: 600; }
        .card-part-badge.beginner { background: rgba(34,197,94,.2); color: var(--green); border: 1px solid rgba(34,197,94,.4); }
        .card-part-badge.intermediate { background: rgba(234,179,8,.2); color: var(--yellow); border: 1px solid rgba(234,179,8,.4); }
        .card-part-badge.advanced { background: rgba(239,68,68,.2); color: var(--red); border: 1px solid rgba(239,68,68,.4); }
        .toc-card h3 { color: var(--accent); margin: 0 0 8px 0; font-size: 1.25em; font-weight: 600; }
        .toc-card .card-subtitle { color: var(--accent-2); font-size: 0.95em; margin-bottom: 12px; }
        .toc-card p { color: var(--muted); font-size: 0.9em; line-height: 1.6; margin: 0 0 16px 0; }
        .card-chapters { display: flex; flex-wrap: wrap; gap: 6px; }
        .chapter-tag { background: rgba(50,108,229,.2); color: var(--accent-2); padding: 4px 10px; border-radius: 6px; font-size: 11px; border: 1px solid rgba(50,108,229,.3); }

        /* Appendix cards */
        .appendix-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 30px; }
        .appendix-card { background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px; padding: 20px; transition: all 0.3s ease; }
        .appendix-card:hover { border-color: var(--k8s); background: #1e3a5f; }
        .appendix-card a { text-decoration: none; color: inherit; }
        .appendix-card h4 { color: var(--accent); margin: 0 0 8px 0; font-size: 1.05em; }
        .appendix-card p { color: var(--muted); margin: 0; font-size: 0.85em; }

        /* ============================================
           AUGMENTATIONS (better than cka_1)
           ============================================ */
        /* Reading progress bar */
        .read-progress { position: fixed; top: 0; left: 0; height: 3px; width: 0; background: linear-gradient(90deg, var(--k8s), var(--accent)); z-index: 1200; transition: width .08s linear; }
        @media (min-width: 1000px) { .read-progress { left: var(--sidebar-w); } body.nav-closed .read-progress { left: 0; } }

        /* Sidebar live filter */
        .sidebar-filter { padding: 0 16px 12px; }
        .sidebar-filter input { width: 100%; background: var(--panel-2); border: 1px solid var(--border); border-radius: 8px; color: var(--text); padding: 9px 12px; font-size: 13px; }
        .sidebar-filter input::placeholder { color: #6b7280; }
        .sidebar-filter input:focus { outline: none; border-color: var(--k8s); box-shadow: 0 0 0 2px rgba(50,108,229,.25); }
        .chapter-item.filtered-out, .sub-toc li.filtered-out { display: none; }
        li.part-hidden { display: none; }
        .filter-empty { display:none; color: var(--muted); font-size: 12px; text-align: center; padding: 12px; }
        .filter-empty.show { display: block; }

        /* "Start Here" group accent (green like cka_1's START HERE) */
        .part-header.start-here { background: linear-gradient(135deg,#14532d 0%,#0f2744 100%); border-color: var(--green); }
        .part-header.start-here:hover { background: linear-gradient(135deg,#166534 0%,#1e3a5f 100%); }

        /* Active sub-section link (scrollspy, deeper than cka_1) */
        .sub-toc a.active { color: var(--accent); background: var(--panel-2); border-left: 2px solid var(--k8s); }

        /* Keyboard focus visibility (a11y) */
        .part-header:focus-visible, .chapter-link:focus-visible, .sub-toc a:focus-visible,
        .toc-card a:focus-visible, .appendix-card a:focus-visible, .toc-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

        /* Back-to-top floating button */
        .to-top { position: fixed; right: 22px; bottom: 22px; width: 46px; height: 46px; border-radius: 50%;
            border: 1px solid var(--k8s); background: linear-gradient(135deg,#1e3a5f,#326ce5); color: #fff;
            font-size: 20px; cursor: pointer; opacity: 0; visibility: hidden; transition: opacity .25s ease, transform .2s ease;
            z-index: 1100; box-shadow: 0 4px 12px rgba(0,0,0,.4); }
        .to-top.show { opacity: 1; visibility: visible; }
        .to-top:hover { transform: translateY(-3px); }


        /* ============================================================
           CHAPTER CONTENT COMPONENTS  (ported + augmented from cka_1)
           ============================================================ */
        .chapter { max-width: 1180px; margin: 0 auto; padding: 28px 4px 8px; }
        .chapter > h2.chapter-title {
            font-size: 2em; line-height: 1.2; margin: 10px 0 6px; color: var(--accent-2);
            border-bottom: 2px solid var(--k8s); padding-bottom: 12px; scroll-margin-top: 20px;
        }
        .chapter-lead { font-size: 1.08em; color: var(--text); opacity: .92; margin: 14px 0 18px; }
        .chapter p { margin: 12px 0; }
        .chapter h3.section-h { font-size: 1.45em; color: var(--accent); margin: 34px 0 12px; scroll-margin-top: 20px; }
        .chapter h4 { font-size: 1.12em; color: var(--accent-2); margin: 22px 0 10px; }
        .section-block { scroll-margin-top: 16px; padding-top: 6px; }
        .chapter h4[id] { scroll-margin-top: 20px; }   /* in-page anchors land cleanly (e.g. §3.2 component sub-menu) */
        .section-block + .section-block { border-top: 1px dashed var(--border); margin-top: 30px; }

        /* meta tag row */
        .chapter-meta { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 4px; }
        .meta-tag { font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 20px;
            background: var(--panel-2); border: 1px solid var(--border); color: var(--accent-2); }

        /* learning objectives */
        .learning-objectives { background: linear-gradient(135deg,#14532d22,#0f274422); border: 1px solid #2f6f46;
            border-radius: 12px; padding: 16px 20px; margin: 18px 0; }
        .learning-objectives h4 { margin: 0 0 10px; color: var(--green); }
        .learning-objectives ul { margin: 0; padding-left: 4px; list-style: none; }
        .learning-objectives li { margin: 6px 0; padding-left: 4px; }

        /* CKA relevance */
        .cka-chapter-relevance { display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
            background: rgba(234,179,8,.08); border: 1px solid rgba(234,179,8,.35); border-radius: 10px; padding: 10px 16px; margin: 16px 0; }
        .relevance-label { font-weight: 700; color: var(--yellow); font-size: 13px; }
        .relevance-domains { display: flex; flex-wrap: wrap; gap: 8px; }
        .cka-domain-badge { font-size: 12px; padding: 4px 10px; border-radius: 14px; background: var(--panel-2);
            border: 1px solid var(--border); color: var(--text); }
        .cka-weight { color: var(--yellow); font-weight: 700; margin-left: 4px; }

        /* callout boxes */
        .info-box { border-radius: 10px; padding: 14px 18px; margin: 18px 0; border-left: 5px solid var(--k8s);
            background: var(--panel); border-top: 1px solid var(--border); border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
        .info-box h5 { margin: 0 0 8px; font-size: 1.02em; }
        .info-box.note { border-left-color: var(--accent); background: rgba(96,165,250,.07); }
        .info-box.tip { border-left-color: var(--green); background: rgba(74,222,128,.07); }
        .info-box.warning { border-left-color: var(--yellow); background: rgba(234,179,8,.08); }
        .info-box.danger { border-left-color: var(--red); background: rgba(248,113,113,.08); }

        .cka-exam-tip { border-radius: 10px; padding: 14px 18px; margin: 18px 0;
            background: linear-gradient(135deg, rgba(234,179,8,.12), rgba(50,108,229,.08));
            border: 1px solid rgba(234,179,8,.4); border-left: 5px solid var(--yellow); }
        .cka-exam-tip h5 { margin: 0 0 8px; color: var(--yellow); }
        .cka-gotcha { border-left: 5px solid var(--red); background: rgba(248,113,113,.08);
            border-radius: 10px; padding: 14px 18px; margin: 18px 0; }
        .cka-gotcha h5 { margin: 0 0 8px; color: var(--red); }
        .cka-speed-tip { border-left: 5px solid var(--green); background: rgba(74,222,128,.08);
            border-radius: 10px; padding: 14px 18px; margin: 18px 0; }
        .cka-speed-tip h5 { margin: 0 0 8px; color: var(--green); }

        /* info / concept cards in a grid */
        .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 18px 0; }
        .card-grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
        .info-card { background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
            padding: 16px; transition: transform .15s ease, border-color .15s ease; }
        .info-card:hover { transform: translateY(-3px); border-color: var(--k8s); }
        .info-card .card-icon-lg { font-size: 2em; display: block; margin-bottom: 8px; }
        .info-card h5 { margin: 0 0 6px; color: var(--accent-2); font-size: 1.05em; }
        .info-card p { margin: 0; font-size: .94em; color: var(--text); opacity: .9; }

        /* metric stat cards */
        .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 14px; margin: 18px 0; }
        .metric-card { background: linear-gradient(135deg, var(--panel), var(--panel-2)); border: 1px solid var(--border);
            border-radius: 12px; padding: 18px; text-align: center; }
        .metric-value { font-size: 2em; font-weight: 800; color: var(--accent); display: block; }
        .metric-label { font-size: .85em; color: var(--muted); margin-top: 4px; }

        /* code blocks (terminal style) */
        .code-block-wrapper { margin: 18px 0; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); background: #0a0e14; }
        .code-block-header { display: flex; align-items: center; gap: 7px; padding: 9px 14px; background: var(--panel-2); border-bottom: 1px solid var(--border); }
        .code-dot { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }
        .code-dot.red { background: #ff5f56; } .code-dot.yellow { background: #ffbd2e; } .code-dot.green { background: #27c93f; }
        .code-lang { margin-left: 8px; font-size: 12px; color: var(--muted); font-family: ui-monospace, monospace; }
        .code-block-wrapper pre { margin: 0; padding: 14px 16px; overflow-x: auto; background: #0a0e14; }
        .code-block-wrapper code, pre code { font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace; font-size: 13.5px; line-height: 1.6; }
        .code-block-wrapper .comment, pre .comment { color: var(--muted); font-style: italic; }

        /* anatomy card (field-by-field) */
        .anatomy-card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin: 18px 0; }
        .anatomy-header { background: linear-gradient(135deg,#1e3a5f,#0f2744); padding: 10px 16px; }
        .anatomy-header h4 { margin: 0; color: var(--accent-2); }
        .anatomy-body { background: var(--panel); }
        .anatomy-row { display: grid; grid-template-columns: minmax(150px, 230px) 1fr; gap: 12px; padding: 11px 16px; border-top: 1px solid var(--border); }
        .anatomy-label { font-weight: 600; color: var(--accent); font-family: ui-monospace, monospace; font-size: .92em; }
        .anat-icon { margin-right: 6px; }
        .anatomy-value { color: var(--text); opacity: .92; font-size: .94em; }

        /* ASCII diagrams */
        .diagram-container { margin: 30px 0; border: 1px solid var(--k8s); border-radius: 12px; overflow: hidden; background: var(--panel); }
        .diagram-title { background: linear-gradient(135deg,#1e3a5f,#0f2744); padding: 9px 16px; font-weight: 600; color: var(--accent-2); font-size: .95em; }
        .diagram-container pre, .diagram-box { margin: 0; padding: 24px 26px; overflow-x: auto; background: #0a0e14;
            font-family: ui-monospace, monospace; font-size: 13px; line-height: 1.75; color: var(--accent-2); }
        .diagram-box { border-radius: 12px; border: 1px solid var(--k8s); }

        /* relationship / hub-spoke map */
        .relationship-map { text-align: center; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin: 18px 0; }
        .rel-hub { display: inline-block; background: linear-gradient(135deg,#326ce5,#1e3a5f); color: #fff; font-weight: 700;
            padding: 12px 26px; border-radius: 10px; margin-bottom: 16px; box-shadow: 0 4px 12px rgba(50,108,229,.4); }
        .rel-spokes { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
        .rel-spoke { background: var(--panel-2); border: 1px solid var(--border); border-radius: 20px; padding: 7px 14px; font-size: .88em; }

        /* process steps */
        .process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 12px; margin: 20px 0; counter-reset: step; }
        .process-step-item { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; text-align: center; position: relative; }
        .step-number { width: 32px; height: 32px; border-radius: 50%; background: var(--k8s); color: #fff; font-weight: 700;
            display: flex; align-items: center; justify-content: center; margin: 0 auto 8px; }
        .process-step-item h5 { margin: 0 0 4px; color: var(--accent-2); }
        .process-step-item p { margin: 0; font-size: .85em; }

        /* tables */
        .chapter table, .comparison-table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: .93em;
            background: var(--panel); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
        .chapter th, .comparison-table th { background: var(--panel-2); color: var(--accent-2); text-align: left; padding: 10px 14px; border-bottom: 2px solid var(--k8s); }
        .chapter td, .comparison-table td { padding: 9px 14px; border-top: 1px solid var(--border); vertical-align: top; }
        .chapter tbody tr:hover { background: rgba(50,108,229,.06); }

        /* under-the-hood collapsible */
        details.uth { margin: 18px 0; border: 1px solid #5b3fa0; border-radius: 10px; background: rgba(124,58,237,.06); overflow: hidden; }
        details.uth > summary { cursor: pointer; padding: 12px 16px; font-weight: 600; color: #c4b5fd; list-style: none; background: rgba(124,58,237,.12); }
        details.uth > summary::-webkit-details-marker { display: none; }
        details.uth > summary::before { content: "🔧 "; }
        details.uth[open] > summary::before { content: "🔧 "; }
        .uth-body { padding: 14px 18px; }
        .uth-callout { background: rgba(124,58,237,.1); border-left: 4px solid #7c3aed; border-radius: 8px; padding: 12px 16px; margin: 14px 0; }
        .uth-diagram { margin: 0; padding: 22px 24px; overflow-x: auto; background: #0a0e14; border-radius: 8px;
            font-family: ui-monospace, monospace; font-size: 12.5px; line-height: 1.75; color: var(--accent-2); }

        /* exam questions */
        .cka-exam-questions { margin: 30px 0; border: 1px solid rgba(234,179,8,.4); border-radius: 12px; padding: 18px 20px; background: rgba(234,179,8,.04); }
        .cka-exam-questions > h4 { margin: 0 0 14px; color: var(--yellow); font-size: 1.2em; }
        .exam-question-item { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin: 12px 0; }
        .eq-number { display: inline-block; background: var(--k8s); color: #fff; font-weight: 700; font-size: 12px; padding: 3px 10px; border-radius: 12px; margin-bottom: 8px; }
        .eq-question { margin: 4px 0 8px; font-weight: 500; }
        .exam-question-item details > summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: .9em; padding: 4px 0; }
        .eq-answer-label, .eq-exp-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700; margin: 10px 0 4px; }
        .eq-answer-label { color: var(--green); } .eq-exp-label { color: var(--accent-2); }
        .eq-explanation { background: var(--panel-2); border-radius: 8px; padding: 10px 14px; margin-top: 8px; font-size: .92em; }

        /* key takeaways banner */
        .key-takeaways { background: linear-gradient(135deg,#0f2744,#14532d); border: 1px solid var(--k8s); border-radius: 12px; padding: 18px 22px; margin: 26px 0; }
        .key-takeaways h4 { margin: 0 0 10px; color: var(--green); }
        .key-takeaways ul { margin: 0; padding-left: 22px; }
        .key-takeaways li { margin: 7px 0; }

        /* visual summary */
        .visual-summary { border: 2px solid var(--k8s); border-radius: 12px; padding: 4px; margin: 26px 0; background: var(--panel); }
        .visual-summary .diagram-title { border-radius: 8px; }

        /* misc inline */
        .chapter code { background: var(--panel-2); border: 1px solid var(--border); border-radius: 4px; padding: 1px 6px; font-family: ui-monospace, monospace; font-size: .9em; color: #f0a868; }
        .chapter pre code { background: none; border: none; padding: 0; color: var(--text); }
        .badge { display: inline-block; font-size: 11px; padding: 2px 9px; border-radius: 12px; background: var(--panel-2); border: 1px solid var(--border); }
        .badge-exam { background: rgba(234,179,8,.2); color: var(--yellow); border-color: rgba(234,179,8,.5); }
        .mb-0 { margin-bottom: 0; }
        .tac { text-align: center; }
        /* drill "show solution" collapsible (matches the green Drill tip box) */
        .info-box details.drill { margin-top: 12px; }
        .info-box details.drill > summary { cursor: pointer; display: inline-block; list-style: none; font-weight: 600;
            font-size: .85em; color: var(--green); padding: 5px 12px; background: rgba(74,222,128,.1);
            border: 1px solid rgba(74,222,128,.32); border-radius: 7px; transition: all .2s ease; }
        .info-box details.drill > summary::-webkit-details-marker { display: none; }
        .info-box details.drill > summary::before { content: "▶ "; font-size: .8em; }
        .info-box details.drill[open] > summary::before { content: "▼ "; }
        .info-box details.drill > summary:hover { background: rgba(74,222,128,.2); }
        .info-box details.drill .drill-solution { margin-top: 12px; }
        .info-box details.drill .drill-solution p { margin: 8px 0; }
        /* drill step list — each step on its own line with a numbered badge */
        .info-box ol.drill-steps { list-style: none; counter-reset: ds; margin: 12px 0 0; padding-left: 0; }
        .info-box ol.drill-steps li { counter-increment: ds; position: relative; margin: 0; padding: 7px 0 7px 36px; line-height: 1.6; }
        .info-box ol.drill-steps li + li { border-top: 1px dashed rgba(74,222,128,.18); }
        .info-box ol.drill-steps li::before { content: counter(ds); position: absolute; left: 0; top: 7px;
            width: 24px; height: 24px; border-radius: 50%; background: var(--green); color: #06210f;
            font-weight: 700; font-size: .8em; display: flex; align-items: center; justify-content: center; }

        /* chapter header card — cka_1 style: boxed intro with rainbow top accent */
        .chapter-intro { position: relative; overflow: hidden; margin: 8px 0 36px;
            background: linear-gradient(135deg, #1e3a5f 0%, #161b22 100%);
            border: 1px solid var(--k8s); border-radius: 16px; padding: 30px 32px;
            box-shadow: 0 4px 24px rgba(50,108,229,.12); }
        .chapter-intro::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 3px;
            background: linear-gradient(90deg,#326ce5,#60a5fa,#a78bfa,#60a5fa,#326ce5); border-radius: 16px 16px 0 0; }
        /* title sits INSIDE the card — neutralize the loose gradient-text + underline look */
        .chapter-intro .chapter-title { font-size: 1.7em; line-height: 1.25; color: var(--accent); margin: 0 0 12px;
            border-bottom: none; padding-bottom: 0; background: none;
            -webkit-text-fill-color: currentColor; -webkit-background-clip: border-box; background-clip: border-box; }
        .chapter-intro .chapter-title::after { display: none; }
        .chapter-intro .chapter-lead { color: var(--ink); font-size: 1.06em; line-height: 1.7; margin: 0; opacity: 1; }
        .chapter-intro .chapter-meta { margin: 16px 0 0; }
        @media (max-width: 720px) { .chapter-intro { padding: 22px 18px; } .chapter-intro .chapter-title { font-size: 1.35em; } }

        /* PART COVER — the big banner that opens each Part */
        .part-cover { position: relative; overflow: hidden; scroll-margin-top: 16px; margin: 24px 0 44px; padding: 40px 38px;
            border: 1px solid var(--k8s); border-radius: 18px;
            background: linear-gradient(135deg, #0f2744 0%, #1e3a5f 52%, #0a1929 100%);
            box-shadow: 0 8px 34px rgba(0,0,0,.38); }
        .part-cover::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px;
            background: linear-gradient(90deg,#326ce5,#60a5fa,#a78bfa,#4ade80,#facc15); }
        .part-cover::after { content: "☸"; position: absolute; right: -28px; top: -46px; font-size: 230px; opacity: .05; pointer-events: none; }
        .part-kicker { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
            color: var(--accent-2); background: rgba(50,108,229,.25); border: 1px solid rgba(50,108,229,.5); border-radius: 20px; padding: 5px 16px; }
        .part-cover-title { font-size: 2.4em; line-height: 1.12; margin: 16px 0 6px; font-weight: 800;
            background: linear-gradient(135deg,#60a5fa,#93c5fd,#a78bfa); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .part-cover-sub { color: var(--muted); font-size: 1em; margin: 0 0 18px; }
        .part-cover-lead { color: var(--ink); font-size: 1.08em; line-height: 1.75; margin: 0 0 6px; max-width: 940px; position: relative; }
        .part-goal { background: rgba(74,222,128,.1); border: 1px solid rgba(74,222,128,.35); border-left: 4px solid var(--green);
            border-radius: 10px; padding: 14px 18px; margin: 20px 0 6px; color: var(--ink); position: relative; }
        .part-goal strong { color: var(--green); }
        .part-cover .diagram-container { margin-bottom: 0; position: relative; }
        @media (max-width: 720px) { .part-cover { padding: 26px 18px; } .part-cover-title { font-size: 1.7em; } }

        /* PART RECAP banner — a distinct "you completed this Part" look (green), set apart from
           chapter intros (blue card) AND part-opener covers (blue, rainbow bar, ☸ watermark). */
        .part-cover.recap { background: linear-gradient(135deg,#06291b 0%,#0d3b29 52%,#07140f 100%);
            border: 1px solid rgba(74,222,128,.5); box-shadow: 0 8px 34px rgba(4,32,21,.55), inset 0 1px 0 rgba(74,222,128,.12);
            border-left: 5px solid var(--green); }
        .part-cover.recap::before { background: linear-gradient(90deg,#15803d,#4ade80,#86efac,#4ade80,#15803d); height: 4px; }
        .part-cover.recap::after { content: "✓"; color: #4ade80; right: 6px; top: -58px; font-size: 220px; font-weight: 800; opacity: .07; }
        .part-cover.recap .part-kicker { color: #86efac; background: rgba(74,222,128,.16); border-color: rgba(74,222,128,.5); }
        .part-cover.recap .part-cover-title { background: linear-gradient(135deg,#4ade80,#86efac,#34d399);
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        .part-cover.recap .part-cover-lead::before { content: "🏁 "; }

        /* PART 1 COVER — distinct teal/cyan theme so the very first thing a reader sees
           doesn't repeat the navy-blue gradient + rainbow bar that Chapter 1's own
           .chapter-intro uses right below it (both used var(--k8s) blue before). Scoped to
           #part1 only — Parts 2-11 keep the shared blue .part-cover look. */
        #part1.part-cover { background: linear-gradient(135deg, #1a0a2e 0%, #241040 52%, #1a0a2e 100%);
            border-color: #3f2a5e; box-shadow: 0 8px 34px rgba(0,0,0,.38), inset 0 1px 0 rgba(167,139,250,.1); }
        #part1.part-cover::before { background: linear-gradient(90deg,#0e7490,#22d3ee,#67e8f9,#22d3ee,#0e7490); }
        #part1.part-cover::after { color: #22d3ee; }
        #part1.part-cover .part-kicker { color: #67e8f9; background: rgba(6,182,212,.22); border-color: rgba(6,182,212,.5); }
        #part1.part-cover .part-cover-title { background: linear-gradient(135deg,#22d3ee,#67e8f9,#a5f3fc);
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
        /* "Before You Start" label + myths table inside Part 1: deep red/orange "caution" theme
           (fits the myth-busting content better than green/teal ever did), scoped so every OTHER
           diagram-title / comparison-table in the guide keeps its normal blue look.
           .myth-table-title (not bare .diagram-title) so the OTHER diagram-title on this same
           cover — the chapter-flow diagram lower down — is untouched. */
        #part1 .myth-table-title { background: linear-gradient(135deg,#4a1408,#2e0d05); color: #fdba74; }
        #part1 .comparison-table th { background: linear-gradient(135deg,#4a1408 0%,#2e0d05 100%); color: #fdba74;
            border-bottom: 2px solid #f97316; }
        /* chapter-flow diagram box at the bottom of Part 1's cover: same navy-blue-tinted
           gradient/border/glow every other diagram-container in the guide uses (only one
           .diagram-container sits inside #part1, so this scoping is safe) — swapped to a
           deep, dark blue (darker/moodier than the doc-wide k8s blue) so the cover's overall
           background (now purple/violet) and this box read as two distinct, deliberate tones. */
        #part1 .diagram-container { background: linear-gradient(140deg,#050b18 0%,#0a1530 50%,#050b18 100%);
            border-color: #1a2a4a; box-shadow: 0 6px 22px rgba(59,90,180,.10), inset 0 1px 0 rgba(59,90,180,.10); }
        .highlight { background: rgba(234,179,8,.22); border-radius: 3px; padding: 0 3px; }
        .analogy-box { border-left: 5px solid #a78bfa; background: rgba(167,139,250,.08); border-radius: 10px; padding: 14px 18px; margin: 18px 0; }
        .analogy-box h5 { margin: 0 0 6px; color: #c4b5fd; }

        /* card-grid column variants + highlight */
        .card-grid.cols-4 { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
        .card-grid.cols-5 { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
        .info-card.highlight { border-color: var(--k8s); background: linear-gradient(135deg, rgba(50,108,229,.12), var(--panel)); box-shadow: 0 0 0 1px rgba(50,108,229,.25); }
        .info-card ul { margin: 8px 0 0; padding-left: 18px; font-size: .9em; }
        .info-card li { margin: 4px 0; }

        /* evolution strip (era timeline) */
        .evolution-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px,1fr)); gap: 12px; margin: 18px 0; }
        .evo-item { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; text-align: center; position: relative; transition: transform .15s ease; }
        .evo-item.active { border-color: var(--k8s); background: linear-gradient(135deg, rgba(50,108,229,.14), var(--panel)); box-shadow: 0 0 14px rgba(50,108,229,.25); }
        .evo-item:hover { transform: translateY(-3px); }
        .evo-icon { font-size: 2.2em; }
        .evo-era { font-size: .8em; color: var(--muted); font-weight: 700; letter-spacing: 1px; margin: 4px 0; }
        .evo-item h5 { margin: 4px 0 6px; color: var(--accent-2); }
        .evo-item p { margin: 0 0 10px; font-size: .86em; opacity: .9; }
        .evo-status { font-size: .8em; font-weight: 600; padding: 3px 10px; border-radius: 12px; display: inline-block; }
        .evo-status.bad { background: rgba(248,113,113,.18); color: var(--red); }
        .evo-status.ok { background: rgba(234,179,8,.18); color: var(--yellow); }
        .evo-status.good { background: rgba(74,222,128,.18); color: var(--green); }

        /* scenario boxes (pain vs gain) */
        .scenario-box { border-radius: 12px; padding: 16px 20px; margin: 16px 0; border: 1px solid rgba(248,113,113,.4); background: rgba(248,113,113,.06); border-left: 5px solid var(--red); }
        .scenario-box.positive { border-color: rgba(74,222,128,.4); background: rgba(74,222,128,.06); border-left-color: var(--green); }
        .scenario-box h5 { margin: 0 0 10px; }
        .scenario-box ul { margin: 0; padding-left: 20px; }
        .scenario-box li { margin: 6px 0; }

        /* stat bars */
        .stat-bar-group { margin: 18px 0; display: grid; gap: 12px; }
        .stat-bar-item { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; }
        .stat-bar-label { font-size: .9em; }
        .stat-bar-value { font-weight: 800; color: var(--accent); font-size: 1.05em; }
        .stat-bar { grid-column: 1 / -1; height: 10px; background: var(--panel-2); border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
        .stat-bar-fill { height: 100%; border-radius: 6px; }
        .stat-bar-fill.green { background: linear-gradient(90deg,#16a34a,#4ade80); }
        .stat-bar-fill.blue { background: linear-gradient(90deg,#1e3a8a,#60a5fa); }

        /* layered architecture stack */
        .arch-layers { display: flex; flex-direction: column; gap: 8px; margin: 18px 0; }
        .arch-layer { border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; background: var(--panel); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
        .arch-layer .layer-icon { font-size: 1.5em; }
        .arch-layer .layer-name { font-weight: 700; color: var(--accent-2); min-width: 110px; }
        .arch-layer .layer-desc { font-size: .86em; color: var(--muted); flex: 1; min-width: 160px; }
        .arch-layer .layer-examples { display: flex; flex-wrap: wrap; gap: 6px; }
        .arch-layer .layer-examples span { font-size: .8em; background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px; padding: 2px 9px; }
        .arch-layer.layer-app { border-left: 4px solid var(--green); }
        .arch-layer.layer-k8s { border-left: 4px solid var(--k8s); }
        .arch-layer.layer-infra { border-left: 4px solid var(--yellow); }
        .process-step-item.active { border-color: var(--k8s); background: linear-gradient(135deg, rgba(50,108,229,.12), var(--panel)); }

        /* responsive */
        @media (max-width: 720px) {
            .chapter { padding: 18px 2px; }
            .chapter > h2.chapter-title { font-size: 1.55em; }
            .chapter h3.section-h { font-size: 1.2em; }
            .anatomy-row { grid-template-columns: 1fr; gap: 4px; }
            .diagram-container pre, .diagram-box, .uth-diagram { font-size: 10.5px; line-height: 1.65; }
            .diagram-box, .uth-diagram { padding: 14px 12px; }
            .diagram-container { padding: 16px 12px; }
            .code-block-wrapper code, pre code { font-size: 12px; }
        }

        /* ============================================================
           ✨ VISUAL POLISH LAYER — gradient fills, accent bars, glows,
           hover lifts, label tags. Overrides the base rules above.
           ============================================================ */
        :root{
            --ink:#c9d1d9; --ink-soft:#a1a1aa; --line:#1e3a5f;
            --violet:#8b5cf6; --violet-2:#a78bfa; --indigo:#6366f1; --indigo-2:#818cf8;
            --amber:#f59e0b; --amber-2:#fbbf24; --mono:'Cascadia Code','Fira Code','JetBrains Mono',ui-monospace,Menlo,Consolas,monospace;
        }
        .chapter { max-width: 100%; }   /* fill <main> (1920px) like the header & TOC */
        .chapter p { color: var(--ink); font-size: .96em; line-height: 1.75; }
        .chapter-lead { color: var(--ink); opacity: 1; font-size: 1.1em; line-height: 1.75; }
        .chapter > h2.chapter-title {
            border-bottom: none; padding-bottom: 14px; letter-spacing:.2px;
            background: linear-gradient(135deg,#dbeafe,#93c5fd 45%,#60a5fa);
            -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        }
        .chapter > h2.chapter-title::after {
            content:""; display:block; height:3px; margin-top:14px; border-radius:3px;
            background: linear-gradient(90deg,#326ce5,#60a5fa 40%,transparent);
        }
        .chapter h3.section-h {
            border-bottom: 2px solid transparent; padding-bottom: 10px;
            border-image: linear-gradient(90deg,#326ce5,#60a5fa,transparent) 1;
        }
        .chapter h4 { letter-spacing:.2px; }
        .section-block { margin: 40px 0; }
        .section-block + .section-block { border-top: none; }

        /* meta tags — frosted pills */
        .meta-tag { display:inline-flex; align-items:center; gap:6px; background: rgba(50,108,229,.12);
            border:1px solid rgba(50,108,229,.28); color: var(--accent-2); backdrop-filter: blur(4px); transition: all .2s ease; }
        .meta-tag:hover { background: rgba(50,108,229,.22); border-color: rgba(50,108,229,.55); transform: translateY(-1px); }

        /* learning objectives — gradient + top accent bar */
        .learning-objectives { background: linear-gradient(135deg,#0d1a12,#161b22); border:1px solid #238636;
            border-radius:14px; padding:22px 26px; position:relative; box-shadow:0 2px 16px rgba(35,134,54,.1); }
        .learning-objectives::before { content:""; position:absolute; inset:0 0 auto 0; height:2px;
            background: linear-gradient(90deg,transparent,#238636,#3fb950,#238636,transparent); border-radius:14px 14px 0 0; }
        .learning-objectives h4 { color:#3fb950; }
        .learning-objectives li { color: var(--ink); }

        /* CKA relevance — gradient */
        .cka-chapter-relevance { background: linear-gradient(135deg, rgba(234,179,8,.1), rgba(234,179,8,.03));
            border:1px solid rgba(234,179,8,.3); border-radius:12px; padding:12px 18px; }

        /* info-box callouts — gradient fills + thicker glow */
        .info-box { border-radius:12px; padding:18px 22px; border-left:4px solid var(--k8s);
            border-top:none; border-right:none; border-bottom:none; box-shadow:0 2px 12px rgba(0,0,0,.18); }
        .info-box h5 { font-size:1.02em; }
        .info-box p, .info-box ul, .info-box li { color: var(--ink); }
        .info-box.note { background: linear-gradient(135deg, rgba(50,108,229,.12), rgba(50,108,229,.04)); border-left-color:#326ce5; }
        .info-box.note h5 { color:#60a5fa; }
        .info-box.tip { background: linear-gradient(135deg, rgba(34,197,94,.12), rgba(34,197,94,.04)); border-left-color:#22c55e; }
        .info-box.tip h5 { color:#4ade80; }
        .info-box.warning { background: linear-gradient(135deg, rgba(234,179,8,.12), rgba(234,179,8,.04)); border-left-color:#eab308; }
        .info-box.warning h5 { color:#facc15; }
        .info-box.danger { background: linear-gradient(135deg, rgba(239,68,68,.12), rgba(239,68,68,.04)); border-left-color:#ef4444; }
        .info-box.danger h5 { color:#f87171; }

        /* CKA callouts — labelled tags via ::before */
        .cka-exam-tip { background: linear-gradient(135deg, rgba(139,92,246,.1), rgba(168,85,247,.04));
            border:1px solid rgba(139,92,246,.3); border-left:4px solid var(--violet); border-radius:12px;
            padding:18px 22px; box-shadow:0 2px 12px rgba(139,92,246,.1); }
        .cka-exam-tip::before { content:"🎓 CKA EXAM TIP"; display:block; font-size:11px; font-weight:700;
            letter-spacing:1.5px; color:var(--violet-2); margin-bottom:10px; }
        .cka-exam-tip h5 { color:#c4b5fd; margin:0 0 8px; }
        .cka-exam-tip p, .cka-exam-tip li { color: var(--ink); }
        .cka-speed-tip { background: linear-gradient(135deg, rgba(245,158,11,.1), rgba(251,146,60,.04));
            border:1px solid rgba(245,158,11,.3); border-left:4px solid var(--amber); border-radius:12px; padding:18px 22px; }
        .cka-speed-tip::before { content:"⚡ SPEED TIP — save time on the exam"; display:block; font-size:11px;
            font-weight:700; letter-spacing:1px; color:var(--amber-2); margin-bottom:10px; }
        .cka-speed-tip h5 { color:var(--amber-2); margin:0 0 8px; }
        .cka-speed-tip p, .cka-speed-tip li { color: var(--ink); }
        .cka-gotcha { background: linear-gradient(135deg,#2d1b1b,#1a1a2e); border:1px solid #7f1d1d;
            border-left:4px solid #ef4444; border-radius:12px; padding:18px 22px; }
        .cka-gotcha::before { content:"⚠️ EXAM GOTCHA — common mistakes"; display:block; font-size:11px;
            font-weight:700; letter-spacing:1.5px; color:#ef4444; margin-bottom:12px; }
        .cka-gotcha h5 { color:#ef4444; margin:0 0 8px; }
        .cka-gotcha li { color:#d4d4d8; }
        .analogy-box { background: linear-gradient(135deg, rgba(167,139,250,.1), rgba(167,139,250,.03));
            border:1px solid rgba(167,139,250,.3); border-left:4px solid var(--violet-2); border-radius:12px; padding:18px 22px; }
        .analogy-box p, .analogy-box li { color: var(--ink); }

        /* concept cards — gradient + hover lift + reveal accent bar */
        .card-grid { gap:16px; }
        .info-card { background: linear-gradient(145deg,#161b22,#111827); border:1px solid var(--line);
            border-radius:14px; padding:22px; position:relative; overflow:hidden; transition: all .25s ease; }
        .info-card::before { content:""; position:absolute; inset:0 0 auto 0; height:2px;
            background: linear-gradient(90deg,#326ce5,#60a5fa); opacity:0; transition: opacity .25s ease; }
        .info-card:hover { transform: translateY(-3px); border-color:#326ce5; box-shadow:0 8px 24px rgba(50,108,229,.16); }
        .info-card:hover::before { opacity:1; }
        .info-card.highlight { border-color:#326ce5; background: linear-gradient(135deg,#1e3a5f,#161b22); }
        .info-card p { color: var(--ink-soft); }

        /* diagram containers — gradient, top accent bar, glow, uppercase title */
        .diagram-container { background: linear-gradient(135deg,#0d1117,#111827 50%,#0d1117); border:1px solid var(--line);
            border-radius:16px; padding:28px 32px; position:relative;
            box-shadow:0 4px 24px rgba(50,108,229,.08), inset 0 1px 0 rgba(96,165,250,.08); overflow-x:auto; }
        .diagram-container::before { content:""; position:absolute; inset:0 0 auto 0; height:3px; opacity:.75;
            background: linear-gradient(90deg,transparent,#326ce5,#60a5fa,#326ce5,transparent); border-radius:16px 16px 0 0; }
        .diagram-container .diagram-title { background:none; padding:0; color:#8b949e; font-size:12px; font-weight:600;
            text-transform:uppercase; letter-spacing:1.5px; text-align:center; margin-bottom:16px; }
        .diagram-container pre { color:#c9d1d9; font-family: var(--mono); font-size:13px; line-height:1.75; background:none; padding:0; }
        /* center ASCII diagrams as a BLOCK — shrink to content width + auto margins.
           (Never text-align:center a preformatted block — it breaks monospace alignment.)
           Narrow diagrams center; diagrams wider than the container stay scrollable. */
        .diagram-container pre, .visual-summary pre, pre.uth-diagram, .diagram-box {
            width: -moz-fit-content; width: fit-content; max-width: 100%;
            margin-left: auto; margin-right: auto;
        }

        /* anatomy card */
        .anatomy-card { background:#0d1117; border:1px solid var(--line); border-radius:14px; }
        .anatomy-header { background: linear-gradient(135deg,#1e3a5f,#162d50); padding:14px 20px; }
        .anatomy-row { border-top:none; border-bottom:1px solid #1c2333; }
        .anatomy-value code { background: rgba(50,108,229,.15); color:#7ee787; }

        /* code blocks — rich gradient + left accent + glow, lang pushed right */
        .code-block-wrapper { background: linear-gradient(160deg,#0f1a2e,#111c30 40%,#0d1524); border:1px solid var(--line);
            border-left:3px solid #326ce5; border-radius:12px; box-shadow:0 4px 24px rgba(0,0,0,.3), inset 0 1px 0 rgba(50,108,229,.1); }
        .code-block-header { background: linear-gradient(135deg,#152238,#0f1a2e); border-bottom:1px solid var(--line); padding:10px 16px; }
        .code-block-header .code-lang { margin-left:auto; font-style:italic; color:#6b8cbf; }
        .code-block-wrapper pre { background:transparent; padding:18px 22px; }
        .code-block-wrapper code, pre code { font-family: var(--mono); font-size:13.5px; line-height:1.65; }
        .code-block-wrapper .comment, pre .comment { color: var(--muted); }
        /* standalone code blocks (snippets NOT wrapped in .code-block-wrapper, e.g. inside info-cards):
           Prism copies the language class onto the PRE element, so prism-tomorrow paints it brown (#2d2d2d).
           Repaint them with the doc's code aesthetic so every code block is consistent. */
        .chapter pre[class*="language-"]:not(.code-block-wrapper *) {
            background: linear-gradient(160deg,#0f1a2e,#111c30 40%,#0d1524) !important;
            border:1px solid var(--line); border-left:3px solid #326ce5; border-radius:10px;
            padding:14px 16px; margin:12px 0; overflow-x:auto; box-shadow:0 4px 24px rgba(0,0,0,.3); }
        .chapter pre[class*="language-"]:not(.code-block-wrapper *) code { background:none !important; }
        .process-steps { display:flex; align-items:flex-start; gap:0; grid-template-columns:none; margin:28px 0;
            padding:24px 16px; background: linear-gradient(135deg,#0d1117,#111827); border:1px solid var(--line);
            border-radius:14px; overflow-x:auto; position:relative; }
        .process-steps::before { content:""; position:absolute; inset:0 0 auto 0; height:3px; border-radius:14px 14px 0 0;
            background: linear-gradient(90deg,#326ce5,#8b5cf6,#ec4899,#f59e0b,#22c55e); }
        .process-step-item { flex:1; min-width:128px; text-align:center; position:relative; padding:0 8px;
            background:none; border:none; border-radius:0; }
        .process-step-item:not(:last-child)::after { content:"→"; position:absolute; right:-7px; top:16px;
            color:#326ce5; font-size:1.3em; font-weight:bold; }
        .step-number { width:36px; height:36px; background: linear-gradient(135deg,#326ce5,#2563eb);
            box-shadow:0 2px 8px rgba(50,108,229,.4); }
        .process-step-item.active { background:none; border:none; }
        .process-step-item.active .step-number { background: linear-gradient(135deg,#22c55e,#16a34a); box-shadow:0 0 12px rgba(34,197,94,.35); }
        .process-step-item p { color: var(--ink-soft); }

        /* tables — separated, gradient header, rounded, row hover */
        .chapter table, .comparison-table table { border-collapse:separate; border-spacing:0; border:1px solid var(--line);
            border-radius:12px; overflow:hidden; box-shadow:0 2px 16px rgba(50,108,229,.06); }
        .chapter th { background: linear-gradient(135deg,#1e3a5f,#162d50); color:#93c5fd; padding:13px 18px;
            border-bottom:2px solid #326ce5; letter-spacing:.3px; }
        .chapter td { padding:12px 18px; border-top:none; border-bottom:1px solid #1c2333; color: var(--ink); background:#0d1117; }
        .chapter tbody tr:hover td { background:#131a27; }
        .chapter tbody tr:last-child td { border-bottom:none; }

        /* relationship map + evolution + scenario — gradient polish */
        .relationship-map { background: linear-gradient(135deg,#0d1117,#111827); border:1px solid var(--line); border-radius:14px; padding:26px; }
        .rel-hub { box-shadow:0 6px 18px rgba(50,108,229,.45); }
        .rel-spoke { background:#161b22; border:1px solid var(--line); transition: all .2s ease; }
        .rel-spoke:hover { border-color:#326ce5; color:var(--accent); }
        .evo-item { background: linear-gradient(145deg,#161b22,#111827); border:1px solid var(--line); border-radius:12px; padding:20px 16px; }
        .evo-item.active { border-color:#326ce5; background: linear-gradient(135deg,#1e3a5f,#161b22); box-shadow:0 0 20px rgba(50,108,229,.16); }
        .evo-item p { color:#8b949e; }
        .scenario-box { border-radius:14px; padding:22px 24px; background: linear-gradient(135deg,#2d1a1a,#161b22);
            border:1px solid rgba(248,113,113,.5); border-left:5px solid #f87171; box-shadow:0 2px 12px rgba(248,113,113,.06); }
        .scenario-box.positive { background: linear-gradient(135deg,#1a2d1a,#161b22); border-color:rgba(74,222,128,.5); border-left-color:#4ade80; box-shadow:0 2px 12px rgba(74,222,128,.06); }
        .scenario-box li { color: var(--ink); }

        /* stat bars — keep label|value row + full-width bar below; just glossier & taller */
        .stat-bar-label { color:#c9d1d9; }
        .stat-bar-value { color:var(--accent-2); }
        .stat-bar { height:14px; border-radius:8px; background:#21262d; border:none; }
        .stat-bar-fill { border-radius:8px; box-shadow: inset 0 1px 0 rgba(255,255,255,.18); }
        .stat-bar-fill.green { background: linear-gradient(90deg,#16a34a,#22c55e); }
        .stat-bar-fill.blue { background: linear-gradient(90deg,#2563eb,#60a5fa); }

        /* arch-layers polish */
        .arch-layer { background: linear-gradient(145deg,#161b22,#111827); border:1px solid var(--line); border-radius:12px; }

        /* key takeaways — richer gradient + glow */
        .key-takeaways { background: linear-gradient(135deg,#0f2744,#0d2018); border:1px solid #2f6f46; border-radius:14px;
            padding:20px 24px; box-shadow:0 2px 16px rgba(35,134,54,.1); position:relative; }
        .key-takeaways::before { content:""; position:absolute; inset:0 0 auto 0; height:2px; border-radius:14px 14px 0 0;
            background: linear-gradient(90deg,transparent,#3fb950,#60a5fa,transparent); }
        .key-takeaways li { color: var(--ink); }

        /* exam questions — indigo theme, label tag, button summary, colored answer/explanation */
        .cka-exam-questions { background: linear-gradient(135deg, rgba(99,102,241,.07), rgba(139,92,246,.04));
            border:1px solid rgba(99,102,241,.25); border-radius:14px; padding:24px; }
        .cka-exam-questions::before { content:"📝 CKA PRACTICE QUESTIONS — exam simulation"; display:block; font-size:11px;
            font-weight:700; letter-spacing:1.5px; color:var(--indigo-2); margin-bottom:14px; }
        .cka-exam-questions > h4 { color:#a5b4fc; border-bottom:1px solid rgba(99,102,241,.25); padding-bottom:8px; }
        .exam-question-item { background: rgba(15,23,42,.5); border:1px solid rgba(99,102,241,.18); border-radius:10px; padding:16px 18px; }
        .eq-number { background: linear-gradient(135deg,#6366f1,#8b5cf6); }
        .eq-question { color:#e2e8f0; font-weight:500; }
        .eq-question code { background:#1e293b; color:#93c5fd; }
        .exam-question-item details > summary { display:inline-block; cursor:pointer; color:var(--indigo-2); font-weight:600;
            font-size:.85em; padding:6px 12px; background: rgba(99,102,241,.1); border:1px solid rgba(99,102,241,.25);
            border-radius:7px; list-style:none; transition: all .2s ease; }
        .exam-question-item details > summary::-webkit-details-marker { display:none; }
        .exam-question-item details > summary::before { content:"▶ "; font-size:.7em; }
        .exam-question-item details[open] > summary::before { content:"▼ "; }
        .exam-question-item details > summary:hover { background: rgba(99,102,241,.18); color:#a5b4fc; }
        .exam-question-item .eq-answer-label { display:block; color:#4ade80; margin-top:12px; padding:8px 12px 8px; }
        .exam-question-item details > .eq-answer-label ~ p,
        .exam-question-item details > .eq-answer-label ~ table,
        .exam-question-item details > .eq-answer-label ~ ol,
        .exam-question-item details > .eq-answer-label ~ ul { margin-left:12px; margin-right:12px; }
        .eq-explanation { background: rgba(251,146,60,.05); border-left:3px solid #f97316; border-radius:0 8px 8px 0;
            padding:10px 14px; margin-top:10px; }
        .eq-exp-label { color:#fb923c; }

        /* two distinct practice panels: LAB Q&A (indigo, concept) vs DRILLS (teal, hands-on) */
        .cka-exam-questions.lab::before { content:"🧪 LAB Q&A — knowledge check"; }
        .cka-exam-questions.drills { background: linear-gradient(135deg, rgba(20,184,166,.08), rgba(13,148,136,.04));
            border-color: rgba(20,184,166,.3); }
        .cka-exam-questions.drills::before { content:"⚙️ SCENARIO & COMMAND DRILLS — hands-on, exam-style"; color:#2dd4bf; }
        .cka-exam-questions.drills > h4 { color:#5eead4; border-bottom-color: rgba(20,184,166,.28); }
        .cka-exam-questions.drills .exam-question-item { border-color: rgba(20,184,166,.2); }
        .cka-exam-questions.drills .eq-number { background: linear-gradient(135deg,#0d9488,#14b8a6); }
        .cka-exam-questions.drills .eq-question code { background:#0f2e2a; color:#5eead4; }
        .cka-exam-questions.drills .exam-question-item details > summary { color:#5eead4;
            background: rgba(20,184,166,.1); border-color: rgba(20,184,166,.28); }
        .cka-exam-questions.drills .exam-question-item details > summary:hover { background: rgba(20,184,166,.18); color:#99f6e4; }

        /* under-the-hood — amber-bordered, gradient */
        details.uth { border:1px solid #5b3fa0; border-radius:14px; background: linear-gradient(135deg, rgba(124,58,237,.08), rgba(50,108,229,.04)); }
        details.uth > summary { padding:14px 18px; color:#c4b5fd; background: rgba(124,58,237,.14); font-weight:600; }
        details.uth > summary:hover { background: rgba(124,58,237,.2); }
        .uth-body h5 { color:#c4b5fd; margin:18px 0 8px; }
        /* UTH tables — match the violet "under the hood" theme (override the blue default) */
        details.uth table { border-collapse: separate; border-spacing: 0; width: 100%; margin: 16px auto;
            border: 1px solid rgba(124,58,237,.45); border-radius: 12px; overflow: hidden;
            box-shadow: 0 2px 16px rgba(124,58,237,.14); background: rgba(10,8,20,.55); font-size: .92em; }
        details.uth th { background: linear-gradient(135deg,#3a2c6b 0%,#291f4d 100%); color: #d6c8ff;
            text-align: left; font-weight: 600; letter-spacing: .3px; padding: 12px 16px;
            border-bottom: 2px solid #7c3aed; }
        details.uth td { padding: 11px 16px; color: var(--ink); vertical-align: top;
            background: rgba(124,58,237,.05); border-top: 1px solid rgba(124,58,237,.16); }
        details.uth tbody tr:first-child td { border-top: none; }
        details.uth tbody tr:hover td { background: rgba(124,58,237,.14); }
        details.uth td:first-child { color: #c4b5fd; font-weight: 600; }
        details.uth td code { background: rgba(124,58,237,.22); border: 1px solid rgba(124,58,237,.35); color: #e9d5ff; }
        .uth-callout { background: rgba(124,58,237,.12); border-left:4px solid #7c3aed; border-radius:0 8px 8px 0; }

        /* visual summary — glowing frame */
        .visual-summary { border:1px solid #326ce5; border-radius:16px; padding:6px;
            background: linear-gradient(135deg,#0d1117,#111827); box-shadow:0 4px 28px rgba(50,108,229,.18); }
        .visual-summary .diagram-title { background:none; color:#8b949e; text-transform:uppercase; letter-spacing:1.5px;
            font-size:12px; font-weight:600; text-align:center; padding:12px 0 6px; }
        .visual-summary pre { font-family: var(--mono); font-size:13px; line-height:1.75; color:#c9d1d9; padding:6px 24px 22px; margin:0 auto; width:-moz-fit-content; width:fit-content; max-width:100%; overflow-x:auto; }
        /* prose recap that accompanies every visual-summary diagram (diagram + words, never diagram alone) */
        .visual-summary .vs-prose { margin:0 14px 12px; padding:16px 20px; border-top:1px solid rgba(50,108,229,.25);
            background: rgba(13,17,23,.55); border-radius:0 0 12px 12px; }
        .visual-summary .vs-prose p { margin:0 0 10px; color:var(--ink); line-height:1.7; font-size:.95em; }
        .visual-summary .vs-prose p:last-child { margin-bottom:0; }
        .visual-summary .vs-prose strong { color:var(--accent-2); }

        /* inline code — refined */
        .chapter code { background: rgba(50,108,229,.12); border:1px solid rgba(50,108,229,.2); color:#f0a868; font-family: var(--mono); }

        /* ============================================================
           📐 SPACING & RHYTHM — consistent breathing room so nothing
           feels cluttered. (Tuned spacing scale; overrides above.)
           ============================================================ */
        .chapter { padding: 36px 0 56px; }   /* edges align with the TOC grid (main supplies the side gutter) */

        /* generous, even gaps BETWEEN sections */
        .section-block { margin: 64px 0; padding-top: 10px; }
        .section-block:first-of-type { margin-top: 40px; }

        /* uniform vertical rhythm BETWEEN block-level components
           (adjacent margins collapse → a clean, even 30px everywhere) */
        .chapter-meta, .learning-objectives, .cka-chapter-relevance,
        .info-box, .cka-exam-tip, .cka-speed-tip, .cka-gotcha, .analogy-box,
        .diagram-container, .card-grid, .metric-grid, .code-block-wrapper,
        .anatomy-card, .scenario-box, .evolution-strip, .stat-bar-group,
        .arch-layers, .relationship-map, .process-steps, .chapter table,
        .key-takeaways, .visual-summary, details.uth, .cka-exam-questions {
            margin-top: 30px; margin-bottom: 30px;
        }

        /* headings: more space ABOVE than below so they group with the
           content that follows them (clear visual hierarchy) */
        .chapter h3.section-h { margin: 6px 0 20px; }
        .chapter h4 { margin: 42px 0 16px; }
        .chapter h4:first-child { margin-top: 0; }
        .chapter p { margin: 14px 0; }

        /* roomier insides + spacing between repeated items */
        .info-box, .cka-exam-tip, .cka-speed-tip, .cka-gotcha, .analogy-box { padding: 20px 24px; }
        .diagram-container { padding: 28px 30px; }
        .card-grid { gap: 22px; }
        .card-grid .info-card { padding: 24px; }
        .cka-exam-questions { padding: 30px; }
        .exam-question-item { margin: 20px 0; padding: 20px 22px; }
        .exam-question-item:first-of-type { margin-top: 24px; }
        .anatomy-row { padding: 14px 20px; }
        .process-steps { padding: 28px 18px; }
        .key-takeaways { padding: 24px 28px; }
        .key-takeaways li, .info-box li, .scenario-box li { margin: 8px 0; }

        /* the chapter header block gets clear separation before §1.1 */
        .chapter-lead { margin: 18px 0 22px; }

        @media (max-width: 720px) {
            .chapter { padding: 22px 12px 40px; }
            .section-block { margin: 44px 0; }
            .chapter h4 { margin-top: 32px; }
            .chapter-meta, .learning-objectives, .cka-chapter-relevance,
            .info-box, .cka-exam-tip, .cka-speed-tip, .cka-gotcha, .analogy-box,
            .diagram-container, .card-grid, .metric-grid, .code-block-wrapper,
            .anatomy-card, .scenario-box, .evolution-strip, .stat-bar-group,
            .arch-layers, .relationship-map, .process-steps, .chapter table,
            .key-takeaways, .visual-summary, details.uth, .cka-exam-questions {
                margin-top: 22px; margin-bottom: 22px;
            }
        }

        /* ============================================================
           VISUAL UPGRADE 2.0 — depth, gradients, motion (cascade-wins)
           A cohesive lift across every content component. No HTML changes.
           ============================================================ */
        :root {
            --vu-radius: 14px;
            --vu-glow: 0 6px 22px rgba(50,108,229,.10);
            --vu-glow-hover: 0 12px 30px rgba(50,108,229,.20);
            --vu-card: linear-gradient(150deg,#161b22 0%,#0f1622 100%);
            --vu-line: #21314e;
        }
        .chapter { line-height: 1.72; }
        .chapter p { margin: 0 0 14px; }

        /* ---- Section headings: gradient accent bar + clearer hierarchy ---- */
        .chapter .section-h {
            position: relative; padding: 6px 0 10px 18px; margin: 8px 0 18px;
            font-size: 1.5em; letter-spacing: .2px;
            border-bottom: 1px solid var(--vu-line);
        }
        .chapter .section-h::before {
            content: ''; position: absolute; left: 0; top: 4px; bottom: 10px; width: 5px;
            border-radius: 6px; background: linear-gradient(180deg,#60a5fa,#326ce5);
            box-shadow: 0 0 12px rgba(50,108,229,.5);
        }
        .chapter h4 {
            position: relative; padding-left: 14px; margin: 30px 0 14px; color: #cfe0ff; font-size: 1.12em;
        }
        .chapter h4::before {
            content: ''; position: absolute; left: 0; top: .15em; height: 1em; width: 3px;
            border-radius: 3px; background: linear-gradient(180deg,#60a5fa,#326ce5);
        }

        /* ---- Cards: gradient, animated top accent, lift + glow ---- */
        .card-grid { gap: 18px; }
        .info-card {
            background: var(--vu-card); border: 1px solid var(--vu-line); border-radius: var(--vu-radius);
            padding: 22px; transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
            position: relative; overflow: hidden;
        }
        .info-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg,#326ce5,#60a5fa,#7c3aed);
            opacity: 0; transition: opacity .25s ease;
        }
        .info-card:hover { transform: translateY(-3px); border-color: #326ce5; box-shadow: var(--vu-glow-hover); }
        .info-card:hover::before { opacity: 1; }
        .info-card .card-icon-lg {
            font-size: 2.1em; display: inline-block; margin-bottom: 10px;
            filter: drop-shadow(0 3px 8px rgba(50,108,229,.35));
        }
        .info-card h5 { color: #7db4ff; margin: 0 0 8px; font-size: 1.02em; }
        .info-card.highlight {
            border-color: #2f5aa8;
            background: linear-gradient(150deg, rgba(50,108,229,.16) 0%, #131a28 100%);
            box-shadow: inset 0 1px 0 rgba(96,165,250,.12);
        }
        .info-card pre { background: rgba(0,0,0,.28); border:1px solid var(--vu-line); border-radius: 9px; padding: 12px 14px; margin: 8px 0 0; font-size: .82em; }

        /* ---- Diagram container: gradient depth + glow + styled title ---- */
        .diagram-container {
            background: linear-gradient(140deg,#0d1117 0%,#111a2b 50%,#0d1117 100%);
            border: 1px solid var(--vu-line); border-radius: 16px; padding: 26px 30px; margin: 26px 0;
            box-shadow: var(--vu-glow), inset 0 1px 0 rgba(96,165,250,.07); overflow-x: auto;
        }
        .diagram-title {
            color: #8fc0ff; font-weight: 700; font-size: .96em; letter-spacing: .4px;
            margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px dashed var(--vu-line);
            display: flex; align-items: center; gap: 8px;
        }
        .diagram-container pre, pre.uth-diagram, .visual-summary pre {
            font-family: 'JetBrains Mono','Fira Code',ui-monospace,Menlo,Consolas,monospace;
            line-height: 1.5; font-size: .85em; color: #c5d3e8;
        }

        /* ---- Code blocks: cka_1 blue "MacBook terminal" look ---- */
        .code-block-wrapper {
            background: linear-gradient(160deg,#0f1a2e 0%,#111c30 40%,#0d1524 100%);
            border: 1px solid #1e3a5f; border-left: 3px solid #326ce5;
            border-radius: 12px; overflow: hidden; margin: 18px 0;
            box-shadow: 0 4px 24px rgba(0,0,0,.3), inset 0 1px 0 rgba(50,108,229,.10);
        }
        .code-block-header {
            background: linear-gradient(135deg,#152238 0%,#0f1a2e 100%);
            border-bottom: 1px solid #1e3a5f; padding: 9px 15px; gap: 8px;
        }
        .code-lang { margin-left: auto; color: #8fb6ef; font-size: .8em; letter-spacing: .3px; font-style: italic; }
        /* the blue gradient must show through — kill Prism's dark pre/code fill */
        .code-block-wrapper pre,
        .code-block-wrapper pre[class*="language-"] {
            background: transparent !important; border: none !important; border-radius: 0 !important;
            margin: 0 !important; padding: 16px 20px !important; line-height: 1.62; overflow-x: auto;
        }
        .code-block-wrapper pre code,
        .code-block-wrapper code[class*="language-"] {
            background: transparent !important; text-shadow: none !important; color: #c9d6ec;
        }
        .code-block-wrapper .comment, .code-block-wrapper code .comment { color: var(--muted); font-style: italic; }

        /* ---- Tables: gradient header, hover rows, depth ---- */
        .chapter table, .comparison-table table {
            border-collapse: separate; border-spacing: 0; width: 100%; margin: 20px 0;
            border: 1px solid var(--vu-line); border-radius: 12px; overflow: hidden;
            box-shadow: 0 4px 18px rgba(50,108,229,.07);
        }
        .chapter th, .comparison-table th {
            background: linear-gradient(135deg,#1e3a5f 0%,#152844 100%); color: #9fc6ff;
            padding: 13px 18px; text-align: left; font-weight: 600; letter-spacing: .3px;
            border-bottom: 2px solid #326ce5;
        }
        .chapter td, .comparison-table td {
            padding: 12px 18px; border-top: none; border-bottom: 1px solid #1b2740;
            color: var(--ink,#c9d6e8); background: #0c1320; vertical-align: top; transition: background .18s ease;
        }
        .chapter tbody tr:nth-child(even) td { background: #0e1626; }
        .chapter tbody tr:hover td { background: #14233c; }
        .chapter tbody tr:last-child td { border-bottom: none; }

        /* ---- Info boxes: gradient tint + accent bar + soft shadow ---- */
        .info-box {
            border-radius: 12px; padding: 18px 22px; margin: 20px 0;
            border: 1px solid var(--vu-line); border-left-width: 4px; box-shadow: 0 2px 14px rgba(0,0,0,.18);
        }
        .info-box.tip     { border-left-color:#22c55e; background: linear-gradient(135deg, rgba(34,197,94,.12), rgba(34,197,94,.03)); }
        .info-box.note    { border-left-color:#3b82f6; background: linear-gradient(135deg, rgba(59,130,246,.12), rgba(59,130,246,.03)); }
        .info-box.warning { border-left-color:#f59e0b; background: linear-gradient(135deg, rgba(245,158,11,.12), rgba(245,158,11,.03)); }
        .info-box.danger  { border-left-color:#ef4444; background: linear-gradient(135deg, rgba(239,68,68,.12), rgba(239,68,68,.03)); }
        .info-box h5 { margin: 0 0 6px; font-size: 1.02em; }

        /* ---- Callout panels: exam-tip / gotcha / speed-tip / analogy / takeaways ---- */
        .cka-exam-tip {
            background: linear-gradient(135deg, rgba(139,92,246,.12), rgba(168,85,247,.04));
            border: 1px solid rgba(139,92,246,.32); border-left: 4px solid #8b5cf6;
            border-radius: 12px; padding: 20px 24px; box-shadow: 0 2px 14px rgba(139,92,246,.10);
        }
        .cka-gotcha {
            background: linear-gradient(135deg,#2a1a1f 0%,#161522 100%);
            border: 1px solid #7f1d1d; border-left: 4px solid #ef4444; border-radius: 12px; padding: 20px 24px;
        }
        .cka-speed-tip {
            background: linear-gradient(135deg, rgba(234,179,8,.10), rgba(234,179,8,.03));
            border: 1px solid rgba(234,179,8,.30); border-left: 4px solid #eab308; border-radius: 12px; padding: 20px 24px;
        }
        .analogy-box {
            background: linear-gradient(135deg, rgba(16,185,129,.10), rgba(6,95,70,.05));
            border: 1px solid rgba(16,185,129,.28); border-left: 4px solid #10b981; border-radius: 12px; padding: 18px 22px;
        }
        .key-takeaways {
            background: linear-gradient(135deg, rgba(50,108,229,.10), rgba(50,108,229,.03));
            border: 1px solid #2f5aa8; border-radius: 14px; padding: 22px 26px; box-shadow: var(--vu-glow);
        }
        .key-takeaways h4 { color:#8fc0ff; }
        .learning-objectives, .cka-chapter-relevance {
            border-radius: 14px; box-shadow: 0 2px 14px rgba(0,0,0,.18);
        }

        /* ---- Q&A: card rows, gradient pill numbers ---- */
        .exam-question-item {
            background: linear-gradient(150deg, rgba(15,23,42,.55), rgba(13,17,23,.4));
            border: 1px solid var(--vu-line); border-radius: 12px; padding: 18px 20px; margin: 14px 0;
        }
        .eq-number {
            display: inline-block; background: linear-gradient(135deg,#326ce5,#60a5fa); color:#fff;
            font-weight: 700; font-size: .74rem; letter-spacing: .4px; padding: 3px 11px; border-radius: 999px;
            margin-bottom: 8px; box-shadow: 0 2px 8px rgba(50,108,229,.35);
        }
        .cka-exam-questions.drills .eq-number { background: linear-gradient(135deg,#7c3aed,#a78bfa); box-shadow: 0 2px 8px rgba(124,58,237,.35); }
        .eq-answer-label, .eq-exp-label {
            display:inline-block; font-size:.7rem; font-weight:700; letter-spacing:.6px; text-transform:uppercase;
            padding:2px 9px; border-radius:6px; margin-bottom:6px;
        }
        .eq-answer-label { background: rgba(34,197,94,.16); color:#4ade80; padding-bottom: 8px; }
        .eq-exp-label    { background: rgba(96,165,250,.16); color:#7db4ff; }
        .eq-explanation { border-top:1px dashed var(--vu-line); margin-top:10px; padding-top:10px; }

        /* ---- Under-the-Hood: richer gradient summary ---- */
        details.uth {
            border: 1px solid #5b3fa0; border-radius: 14px; overflow: hidden; margin: 22px 0;
            background: linear-gradient(150deg, rgba(124,58,237,.08), rgba(50,108,229,.03));
            box-shadow: 0 4px 20px rgba(124,58,237,.10);
        }
        details.uth > summary {
            padding: 14px 18px; font-weight: 700; color: #c9b6ff; font-size: 1.02em;
            background: linear-gradient(135deg, rgba(124,58,237,.18), rgba(124,58,237,.06));
        }
        .uth-callout {
            background: linear-gradient(135deg, rgba(124,58,237,.14), rgba(124,58,237,.04));
            border-left: 4px solid #8b5cf6; border-radius: 8px; padding: 12px 16px; margin: 14px 0;
        }
        /* UTH ascii diagrams: was a flat black box with no border, visually disconnected from
           the purple details.uth card it sits inside. Tie it into the same purple theme with a
           subtle gradient + border + glow. Covers both markup forms used across the guide -
           a bare pre.uth-diagram (native chapters) and a wrapping div.uth-diagram around an
           inner, unclassed pre (ported chapters) - the nested-pre reset below removes the
           browser-default pre margin so the div-wrapped form doesn't get extra spacing. */
        .uth-diagram, div.uth-diagram {
            background: linear-gradient(150deg, #140b28 0%, #0a0e14 65%, #0a0e14 100%);
            border: 1px solid rgba(124,58,237,.28); border-radius: 10px;
            box-shadow: inset 0 1px 0 rgba(167,139,250,.06), 0 4px 16px rgba(124,58,237,.09);
        }
        .uth-diagram pre { margin: 0; padding: 0; background: none; border: none; box-shadow: none; }

        /* ---- Visual summary + drill polish ---- */
        .visual-summary {
            background: linear-gradient(140deg,#0d1117,#111a2b); border:1px solid var(--vu-line);
            border-radius: 16px; padding: 24px 28px; box-shadow: var(--vu-glow);
        }
        .vs-prose { border-top: 1px solid var(--vu-line); margin-top: 14px; padding-top: 14px; }
        details.drill { border:1px solid #1f7a4d; border-radius: 10px; overflow: hidden; }
        details.drill > summary { background: linear-gradient(135deg, rgba(34,197,94,.16), rgba(34,197,94,.05)); color:#86efac; padding: 11px 16px; font-weight:600; }
        .process-step-item { transition: transform .2s ease, border-color .2s ease; }
        .process-step-item:hover { transform: translateY(-2px); border-color:#326ce5; }

        /* ---- Imperative-command speed reference (ported & upgraded from cka_1; conforms to the cka-* callout family) ---- */
        .cka-imperative-ref {
            background: linear-gradient(135deg, rgba(34,211,238,.10), rgba(6,182,212,.04));
            border: 1px solid rgba(34,211,238,.30); border-left: 4px solid #06b6d4;
            border-radius: 12px; padding: 20px 24px; margin: 30px 0;
            box-shadow: 0 2px 14px rgba(34,211,238,.10);
        }
        .cka-imperative-ref::before {
            content: "⚡ IMPERATIVE COMMANDS — EXAM SPEED REFERENCE"; display: block;
            font-size: 11px; font-weight: 700; letter-spacing: 1.5px; color: #67e8f9; margin-bottom: 12px;
        }
        .cka-imperative-ref h4, .cka-imperative-ref h5 { color: #67e8f9; margin: 0 0 10px; font-size: 1.02em; }
        .cka-imperative-ref strong { color: #a5f3fc; }
        .cka-imperative-ref p, .cka-imperative-ref li { color: var(--ink); }
        .cka-imperative-ref code {
            background: rgba(34,211,238,.12); border: 1px solid rgba(34,211,238,.25);
            color: #7ee787; border-radius: 4px; padding: 1px 6px; font-family: var(--mono);
        }

        /* ============================================================
           PARTS 5–9 EXTENDED COMPONENTS — ported from cka_1 and upgraded
           to the cka.html visual bar (gradients, ≥12px radii, ≥20px pad,
           glows, hover-lift, colored accents). Names already follow the
           cka.html lowercase-hyphen / cka-* convention.
           ============================================================ */

        /* card-grid 3-col variant (cka.html already has cols-2/4/5) */
        .card-grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }

        /* ---- Flow / decision-path diagram (vertical numbered steps) ---- */
        .flow-diagram {
            background: linear-gradient(140deg,#0d1117,#111a2b 50%,#0d1117); border:1px solid var(--vu-line);
            border-radius:16px; padding:24px 28px; margin:30px 0; box-shadow: var(--vu-glow); overflow-x:auto;
        }
        .flow-diagram > h4 { margin:0 0 16px; color:#8fc0ff; text-align:center; padding-left:0; }
        .flow-diagram > h4::before { display:none; }
        .flow-steps { display:flex; flex-direction:column; gap:0; }
        .flow-step {
            background: linear-gradient(150deg,#161b22,#0f1622); border:1px solid var(--vu-line);
            border-left:3px solid #326ce5; border-radius:12px; padding:16px 20px; text-align:left;
        }
        .flow-step-header { display:flex; align-items:center; gap:12px; margin-bottom:4px; }
        .flow-step-number {
            flex:none; width:30px; height:30px; border-radius:50%;
            background: linear-gradient(135deg,#326ce5,#2563eb); color:#fff; font-weight:700;
            display:flex; align-items:center; justify-content:center; font-size:.9em;
            box-shadow:0 2px 8px rgba(50,108,229,.4);
        }
        .flow-step-header h5 { margin:0; color:#cfe0ff; font-size:1.02em; }
        .flow-step > p { margin:4px 0 0; color: var(--ink); font-size:.92em; }
        .flow-connector { text-align:center; color:#326ce5; font-size:1.25em; line-height:1; padding:6px 0; }
        .flow-arrow { color:#326ce5; font-size:1.3em; font-weight:bold; }
        .flow-icon { font-size:1.5em; }

        /* ---- metric color variants + icon (cka.html already has metric-grid/metric-card) ---- */
        .metric-card .metric-icon { font-size:1.8em; display:block; margin-bottom:4px; }
        .metric-card.metric-blue   .metric-value { color:#60a5fa; }
        .metric-card.metric-green  .metric-value { color:#4ade80; }
        .metric-card.metric-orange .metric-value { color:#fb923c; }
        .metric-card.metric-red    .metric-value { color:#f87171; }
        .metric-card.metric-purple .metric-value { color:#a78bfa; }

        /* ---- relationship-map spoke icon + heading (cka.html already has rel-spoke) ---- */
        .relationship-map > h4 { margin:0 0 14px; color:#8fc0ff; text-align:center; padding-left:0; }
        .relationship-map > h4::before { display:none; }
        .rel-spoke { display:flex; flex-direction:column; align-items:center; gap:2px; text-align:center; }
        .rel-spoke .spoke-icon { font-size:1.5em; margin-bottom:2px; }
        .rel-spoke small { color: var(--ink-soft); font-size:.8em; }

        /* ---- inline right/wrong inside a gotcha ---- */
        .cka-gotcha .gotcha-correct { color:#4ade80; font-weight:600; }
        .cka-gotcha .gotcha-wrong { color:#f87171; font-weight:600; text-decoration:line-through; }

        /* ---- badge color variants (cka.html already has .badge/.badge-exam) ---- */
        .badge-concept     { background: rgba(6,182,212,.16); color:#67e8f9; border-color: rgba(6,182,212,.45); }
        .badge-important   { background: rgba(234,179,8,.18); color:#facc15; border-color: rgba(234,179,8,.5); }
        .badge-warning     { background: rgba(245,158,11,.18); color:#fbbf24; border-color: rgba(245,158,11,.5); }
        .badge-performance { background: rgba(139,92,246,.18); color:#c4b5fd; border-color: rgba(139,92,246,.5); }

        /* ---- standalone ASCII diagram: pre.ascii-art ---- */
        pre.ascii-art {
            background: linear-gradient(135deg,#0d1117,#111827); border:1px solid var(--vu-line);
            border-radius:14px; padding:22px 24px; margin:26px auto; overflow-x:auto;
            font-family: var(--mono); font-size:.85em; line-height:1.5; color:#c5d3e8;
            box-shadow: var(--vu-glow); width:-moz-fit-content; width:fit-content; max-width:100%;
        }

        /* ---- rich troubleshooting scenario-box sub-elements (cka.html has base .scenario-box) ---- */
        .scenario-box .scenario-content > p { color: var(--ink); }

        /* ---- cka-yaml-skeleton (memorizable exam template) ---- */
        .cka-yaml-skeleton {
            background: linear-gradient(135deg, rgba(240,136,62,.08), rgba(240,136,62,.03));
            border:1px solid rgba(240,136,62,.3); border-left:4px solid #f0883e;
            border-radius:12px; padding:20px 24px; margin:30px 0; box-shadow:0 2px 14px rgba(240,136,62,.10);
        }
        .cka-yaml-skeleton::before { content:'📋 EXAM YAML SKELETON — TYPE FROM MEMORY'; display:block; font-size:11px; font-weight:700; letter-spacing:1.5px; color:#f0a868; margin-bottom:12px; }
        .cka-yaml-skeleton h4 { color:#f0a868; font-size:1.02em; margin:0 0 6px; padding-left:0; }
        .cka-yaml-skeleton h4::before { display:none; }
        .cka-yaml-skeleton .skeleton-note { color: var(--ink-soft); font-size:.85em; font-style:italic; margin:0 0 12px; }
        .cka-yaml-skeleton pre { background:#0a0e14; border:1px solid var(--vu-line); border-radius:9px; padding:14px 18px; overflow-x:auto; margin:10px 0 0; }
        .cka-yaml-skeleton code { font-family: var(--mono); font-size:13px; line-height:1.6; color:#c9d6ec; }

        /* ---- cka-kubectl-path (kubectl explain field finder) ---- */
        .cka-kubectl-path {
            background: linear-gradient(135deg, rgba(129,140,248,.10), rgba(99,102,241,.04));
            border:1px solid rgba(129,140,248,.3); border-left:4px solid #818cf8;
            border-radius:12px; padding:20px 24px; margin:30px 0; box-shadow:0 2px 14px rgba(99,102,241,.10);
        }
        .cka-kubectl-path::before { content:'🔍 KUBECTL EXPLAIN — FIND YAML FIELDS FAST'; display:block; font-size:11px; font-weight:700; letter-spacing:1.5px; color:#a5b4fc; margin-bottom:12px; }
        .cka-kubectl-path h4 { color:#a5b4fc; font-size:1.02em; margin:0 0 6px; padding-left:0; }
        .cka-kubectl-path h4::before { display:none; }
        .cka-kubectl-path pre { background:#0a0e14; border:1px solid var(--vu-line); border-radius:9px; padding:14px 18px; overflow-x:auto; margin:10px 0; }
        .cka-kubectl-path code { background: rgba(129,140,248,.12); color:#c4b5fd; padding:1px 6px; border-radius:4px; font-family: var(--mono); }
        .cka-kubectl-path ul { padding-left:22px; margin:8px 0 0; }
        .cka-kubectl-path li { color: var(--ink); font-size:.9em; line-height:1.7; }

        /* ---- cka-verify (verification checklist) ---- */
        .cka-verify {
            background: linear-gradient(135deg, rgba(34,197,94,.08), rgba(16,185,129,.03));
            border:1px solid rgba(34,197,94,.25); border-left:4px solid #22c55e;
            border-radius:12px; padding:20px 24px; margin:30px 0; box-shadow:0 2px 14px rgba(34,197,94,.10);
        }
        .cka-verify::before { content:'✅ VERIFY YOUR ANSWER — EXAM CHECKLIST'; display:block; font-size:11px; font-weight:700; letter-spacing:1.5px; color:#4ade80; margin-bottom:12px; }
        .cka-verify h4 { color:#4ade80; font-size:1.02em; margin:0 0 6px; padding-left:0; }
        .cka-verify h4::before { display:none; }
        .cka-verify code { background: rgba(34,197,94,.12); color:#86efac; padding:1px 6px; border-radius:4px; font-family: var(--mono); }
        .cka-verify ul { padding-left:22px; margin:8px 0 0; }
        .cka-verify li { color: var(--ink); font-size:.9em; line-height:1.7; }
        .cka-verify pre, .cka-imperative-ref pre { background:#0a0e14; border:1px solid var(--vu-line); border-radius:9px; padding:14px 18px; overflow-x:auto; margin:10px 0; }
        .cka-verify pre code, .cka-imperative-ref pre code { font-family: var(--mono); font-size:13px; line-height:1.6; color:#c9d6ec; }

        /* ---- cka-practice-drill (timed drill: timer · scenario · hint · collapsible solution) ---- */
        .cka-practice-drill {
            background: linear-gradient(135deg, rgba(16,185,129,.07), rgba(5,150,105,.03));
            border:1px solid rgba(16,185,129,.28); border-radius:16px; padding:26px 28px; margin:32px 0;
            box-shadow:0 2px 16px rgba(16,185,129,.10); position:relative;
        }
        .cka-practice-drill::before { content:'🏋️ CKA PRACTICE DRILL'; display:block; font-size:12px; font-weight:700; letter-spacing:1.5px; color:#34d399; margin-bottom:14px; }
        .cka-practice-drill .drill-timer { display:inline-flex; align-items:center; gap:6px; background: rgba(16,185,129,.15); color:#6ee7b7; padding:4px 14px; border-radius:20px; font-size:12px; font-weight:600; margin-bottom:14px; }
        .cka-practice-drill .drill-scenario { background:#0d1117; border:1px solid rgba(16,185,129,.2); border-radius:10px; padding:16px 20px; margin:12px 0; }
        .cka-practice-drill .drill-scenario h5 { color:#6ee7b7; margin:0 0 8px; font-size:1em; }
        .cka-practice-drill .drill-scenario p, .cka-practice-drill .drill-scenario ol, .cka-practice-drill .drill-scenario ul { color: var(--ink); font-size:.92em; line-height:1.7; margin:6px 0; }
        .cka-practice-drill .drill-scenario ol { padding-left:24px; }
        .cka-practice-drill .drill-hint { background: rgba(245,158,11,.08); border:1px dashed rgba(245,158,11,.3); border-radius:8px; padding:12px 16px; margin-top:12px; font-size:.9em; color:#fde68a; }
        .cka-practice-drill .drill-step { margin:8px 0; }
        .cka-practice-drill .step-content { color: var(--ink); }
        .cka-practice-drill .drill-solution { background: rgba(16,185,129,.08); border:1px solid rgba(16,185,129,.2); border-radius:10px; padding:14px 20px; margin-top:14px; }
        .cka-practice-drill .drill-solution summary { color:#34d399; cursor:pointer; font-weight:600; font-size:.95em; padding:4px 0; list-style:none; }
        .cka-practice-drill .drill-solution summary::-webkit-details-marker { display:none; }
        .cka-practice-drill .drill-solution summary::before { content:"▶ "; font-size:.8em; }
        .cka-practice-drill .drill-solution details[open] summary::before { content:"▼ "; }
        .cka-practice-drill .drill-solution summary:hover { color:#6ee7b7; }
        .cka-practice-drill .drill-solution pre { margin:10px 0 0; background:#0a0e14; border:1px solid var(--vu-line); border-radius:8px; padding:14px 18px; overflow-x:auto; }
        .cka-practice-drill .drill-solution code { font-family: var(--mono); font-size:13px; line-height:1.6; color:#c9d6ec; }

        /* ---- code-box for bare pre blocks in exam answers (cka_1 authored them outside .code-block-wrapper) ---- */
        .exam-question-item pre {
            background: linear-gradient(160deg,#0f1a2e,#0d1524); border:1px solid var(--vu-line);
            border-left:3px solid #326ce5; border-radius:10px; padding:14px 18px; margin:10px 0; overflow-x:auto;
        }
        .exam-question-item pre code { font-family: var(--mono); font-size:13px; line-height:1.6; color:#c9d6ec; }

        /* ============================================================
           PARTS 10–11 EXTENDED COMPONENTS — ported from cka_1, upgraded
           to the visual bar. Names follow the cka.html convention.
           ============================================================ */

        /* ---- decision tree (question -> yes/no branches) ---- */
        .decision-tree {
            background: linear-gradient(140deg,#0d1117,#111a2b 50%,#0d1117); border:1px solid var(--vu-line);
            border-radius:16px; padding:24px 28px; margin:30px 0; box-shadow: var(--vu-glow);
        }
        .decision-node {
            background:#21262d; border:1px solid var(--vu-line); border-radius:10px;
            padding:14px 20px; margin:10px auto; max-width:560px; text-align:center; color: var(--ink); font-size:.92em;
        }
        .decision-node.question { background: linear-gradient(135deg,#1e3a5f,#162d50); border-color:#326ce5; color:#93c5fd; font-weight:600; }
        .decision-node.yes { background: rgba(34,197,94,.15); border-color:#238636; color:#4ade80; }
        .decision-node.no  { background: rgba(239,68,68,.15); border-color:#da3633; color:#f87171; }
        .decision-branches { display:flex; justify-content:center; flex-wrap:wrap; gap:20px; margin:8px 0; }
        .decision-branch-label { color: var(--ink-soft); font-size:.82em; text-align:center; margin-bottom:4px; }

        /* ---- lifecycle pill chain ---- */
        .lifecycle-chain {
            display:flex; align-items:center; flex-wrap:wrap; gap:0; margin:30px 0; padding:20px 16px;
            background: linear-gradient(135deg,#0d1117,#111827); border:1px solid var(--vu-line);
            border-radius:14px; overflow-x:auto; box-shadow: var(--vu-glow);
        }
        .lc-pill {
            display:flex; flex-direction:column; align-items:center; min-width:100px; padding:12px;
            text-align:center; background: linear-gradient(150deg,#161b22,#0f1622); border:1px solid var(--vu-line);
            border-radius:10px; color: var(--ink); font-size:.82em; font-weight:600; margin:4px 2px;
        }
        .lc-pill.active { border-color:#326ce5; background: linear-gradient(135deg,#1e3a5f,#161b22); color:#93c5fd; box-shadow:0 0 12px rgba(50,108,229,.25); }
        .lc-pill h6 { color:#e4e4e7; font-size:.82em; margin:2px 0 0; font-weight:600; }
        .lc-arrow { color:#326ce5; font-size:1.2em; font-weight:bold; padding:0 6px; flex:none; }

        /* ---- icon feature list ---- */
        .icon-feature-list { margin:24px 0; }
        .icon-feature { display:flex; align-items:flex-start; gap:14px; padding:14px 0; border-bottom:1px solid var(--vu-line); }
        .icon-feature:last-child { border-bottom:none; }
        .icon-feature .if-icon {
            font-size:1.4em; min-width:40px; height:40px; display:flex; align-items:center; justify-content:center;
            background: rgba(50,108,229,.1); border:1px solid rgba(50,108,229,.25); border-radius:9px; flex:none;
        }
        .icon-feature h5 { color:#cfe0ff; margin:0 0 3px; font-size:.98em; }
        .icon-feature p { color: var(--ink-soft); font-size:.9em; margin:0; line-height:1.6; }

        /* ---- badge variant ---- */
        .badge-command { background: rgba(16,185,129,.16); color:#6ee7b7; border-color: rgba(16,185,129,.45); }

        /* ============================================================
           APPENDICES A–I — ported from cka_1, upgraded to the visual bar.
           ============================================================ */
        .badge-appendix  { background: rgba(139,92,246,.16); color:#c4b5fd; border-color: rgba(139,92,246,.45); }
        .badge-reference { background: rgba(50,108,229,.16); color:#93c5fd; border-color: rgba(50,108,229,.45); }
        .summary-box {
            background: linear-gradient(135deg, rgba(50,108,229,.10), rgba(139,92,246,.06));
            border:1px solid rgba(50,108,229,.3); border-radius:14px; padding:24px 28px; margin:30px 0;
            box-shadow: var(--vu-glow);
        }
        .summary-box h4 { color:#60a5fa; margin:0 0 14px; font-size:1.1em; padding-left:0; }
        .summary-box h4::before { display:none; }
        .summary-box ul { list-style:none; padding:0; margin:0; }
        .summary-box li { padding:7px 0; color: var(--ink); font-size:.92em; border-bottom:1px solid rgba(50,108,229,.12); }
        .summary-box li:last-child { border-bottom:none; }

        /* ---- structural placeholder (content to be filled in a later pass) ---- */
        .chapter-placeholder {
            border:1px dashed #5b6b8c; border-radius:12px; padding:16px 20px; margin:30px 0;
            background: repeating-linear-gradient(135deg, rgba(91,107,140,.06) 0 12px, transparent 12px 24px);
            color: var(--ink-soft);
        }
        .chapter-placeholder::before {
            content:"🚧 PLACEHOLDER — structure standardised; content to be added"; display:block;
            font-size:11px; font-weight:700; letter-spacing:1px; color:#8fa3c8; margin-bottom:8px;
        }
        .chapter-placeholder h4, .chapter-placeholder h5 { margin:0 0 6px; color:#aab8d4; padding-left:0; }
        .chapter-placeholder h4::before, .chapter-placeholder h5::before { display:none; }
        .chapter-placeholder p { margin:0; font-size:.9em; }
        /* glossary A–Z index — extracted from repeated inline styles (Appendix D) */
        .gloss-letter { color: #60a5fa; border-bottom: 2px solid #1e3a5f; padding-bottom: 0.3rem; }
        .gloss-nav { color: #93c5fd; margin-right: 0.5rem; font-weight: 700; }
        /* per-chapter closing-block jump anchors + submenu demarcation */
        .ch-jump { display:block; height:0; scroll-margin-top:16px; }
        .sub-toc-sep { margin:7px 0 2px; padding-top:5px; border-top:1px solid var(--border); list-style:none; font-size:.6rem; font-weight:700; letter-spacing:.9px; text-transform:uppercase; color:var(--muted); opacity:.8; text-align:right; }
        .sub-toc-x a { text-align:right; justify-content:flex-end; }
        /* ported tables (Parts 4-14): the .comparison-table wrapper added its own top/bottom
           margin on top of the table's - make it layout-transparent so ported tables match the
           bare-table spacing used in Parts 1-3. */
        .comparison-table { display: contents; }
        /* ported ASCII diagrams (Parts 4-14) wrap a pre element in div.diagram-box — that inner
           pre kept its default 1em margin (no rule zeroed it, unlike .diagram-container's pre),
           adding extra space inside the box. Neutralise it so the box provides all the styling. */
        .diagram-box pre { margin: 0; padding: 0; background: none; border: none; font: inherit; color: inherit; }
    </style>
</head>
