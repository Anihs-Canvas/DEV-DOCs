# Copy to .env and adjust. Compose reads these; bare local dev falls back
# to SQLite when POSTGRES_HOST is unset (tests run with zero services).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=basketballpicks
POSTGRES_USER=basketballpicks
POSTGRES_PASSWORD=basketballpicks
# POSTGRES_HOST=localhost   # uncomment to use postgres outside compose
# POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# --- Data sources [bball-01 §4] -------------------------------------------
# The pipeline runs (and no-ops politely) without keys; fill them to go live.

# nba_api / stats.nba.com — KEYLESS but IP/rate-limited. Needs a browser UA
# (stats.nba.com 403s bots). Treated like a keyless source with network
# tolerance (a 429/blip = counted+skipped child, never a raised failure).
# NBA_API_BASE_URL=https://stats.nba.com/stats
# NBA_API_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ... Chrome/124.0 Safari/537.36
# NBA_API_RATE_PER_MIN=20

# The Odds API — BUSINESS tier REQUIRED for player props + Pinnacle + history.
# Team markets on bulk /odds; props on per-event /events/{id}/odds. Business
# is credit-generous, so the daily budget default is high.
THE_ODDS_API_KEY=
# THE_ODDS_API_BASE_URL=https://api.the-odds-api.com
# THE_ODDS_API_DAILY_BUDGET=5000
# THE_ODDS_API_RATE_PER_MIN=30
# THE_ODDS_API_PROP_MARKETS=player_points,player_rebounds,player_assists,player_points_rebounds_assists,player_threes,player_blocks,player_steals

# Optional real-time EV feeds (sharp-fair cross-check). Both no-op when unset.
ODDSJAM_API_KEY=
STATSBENCH_API_KEY=

# DFS pick'em scraper knobs (Underdog / PrizePicks reverse-engineered JSON).
# UNDERDOG_BASE_URL=
# UNDERDOG_USER_AGENT=

# Error monitoring (ADR 010): optional — log-based alerts always fire. With a
# DSN set, settings init sentry-sdk (Django + Celery integrations); unset =
# zero change.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=dev

# Notifications: CSV of console|email|telegram. Default console = log-only.
# NOTIFY_BACKENDS=console
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=basketballpicks@localhost
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
