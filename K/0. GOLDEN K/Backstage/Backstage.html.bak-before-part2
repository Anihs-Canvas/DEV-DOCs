            <section class="section-block" id="b-s12-3">
                <h3 class="section-h">12.3 Custom Template Actions</h3>
                <p>When built-in actions aren't enough, you can create <strong>custom actions</strong> using <code>createTemplateAction()</code>. Common use cases: creating Jira tickets, sending Slack notifications, provisioning cloud resources, or running security scans.</p>
                <div class="diagram-container">
                    <div class="diagram-title">Custom Action Example — Notify Slack</div>
<pre><code class="language-typescript">// plugins/scaffolder-backend-module-easypj/src/actions/notifySlack.ts
import { createTemplateAction } from '@backstage/plugin-scaffolder-node';

export const createNotifySlackAction = () =>
  createTemplateAction&lt;{ channel: string; message: string }&gt;({
    id: 'easypj:notify-slack',
    schema: {
      input: {
        required: ['channel', 'message'],
        properties: {
          channel: { type: 'string' },
          message: { type: 'string' },
        },
      },
    },
    async handler(ctx) {
      ctx.logger.info('Notifying channel: ' + ctx.input.channel);
      <span class="comment">// call your Slack webhook here</span>
      ctx.output('notified', true);
    },
  });</code></pre>
                </div>

