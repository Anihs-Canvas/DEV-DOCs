                <div class="process-steps">
                    <div class="process-step-item active"><div class="step-number">1</div><h5>Create App</h5><p>npx create-app → easypj-portal</p></div>
                    <div class="process-step-item"><div class="step-number">2</div><h5>GitHub Integration</h5><p>Add GitHub token to app-config</p></div>
