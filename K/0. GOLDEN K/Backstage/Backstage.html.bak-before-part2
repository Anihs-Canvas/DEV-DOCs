                            <tr><td><code>publish:gitlab</code></td><td>Create GitLab repo + push code</td><td>repoUrl</td><td>repoContentsUrl, remoteUrl</td></tr>
                            <tr><td><code>publish:bitbucket</code></td><td>Create Bitbucket repo</td><td>repoUrl</td><td>repoContentsUrl, remoteUrl</td></tr>
                            <tr><td><code>publish:azure</code></td><td>Create Azure DevOps repo</td><td>repoUrl</td><td>repoContentsUrl, remoteUrl</td></tr>
                            <tr><td><code>catalog:register</code></td><td>Register entity in Catalog</td><td>repoContentsUrl, catalogInfoPath</td><td>entityRef, catalogInfoUrl</td></tr>
