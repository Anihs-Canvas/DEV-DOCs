            <section class="section-block" id="b-s32-1">
                <h3 class="section-h">32.1 Custom Catalog Processors</h3>
                <ul>
                    <li>Extending the catalog ingestion pipeline</li>
                    <li>Building custom entity providers</li>
                    <li>Custom processors for data transformation</li>
                </ul>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">custom-catalog-processor.ts</span></div>
<pre><code class="language-typescript">// Enriches every Component entity with a computed field
import { CatalogProcessor } from '@backstage/plugin-catalog-node';

export class EasypjEnricher implements CatalogProcessor {
  getProcessorName() { return 'easypj-enricher'; }
  // Signature: postProcessEntity(entity, location, emit, cache)
  // - location: LocationSpec the entity came from
  // - emit: CatalogProcessorEmit, used to emit related entities
  // - cache: CatalogProcessorCache for processor-specific caching
  async postProcessEntity(entity) {
    if (entity.kind === 'Component') {
      entity.metadata.labels ??= {};
      entity.metadata.labels['easypj.io/managed'] = 'true';
    }
    return entity;
  }
}</code></pre>
                </div>
                <div class="info-box note">
                    <h5>📝 CatalogProcessor vs. EntityProvider — pick the right extension point</h5>
                    <p class="mb-0">A <strong>CatalogProcessor</strong> (above) transforms/enriches entities that are <strong>already</strong> in the catalog — one <code>postProcessEntity()</code> call per entity, on every ingestion cycle. An <strong>EntityProvider</strong> is a different, earlier extension point: it <strong>introduces</strong> entities into the catalog from an external system (e.g. a CMDB) that has no static <code>catalog-info.yaml</code> to point Backstage at. Reach for a CatalogProcessor to enrich; reach for an EntityProvider to ingest from a system with no file to discover.</p>
                </div>
                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">custom-entity-provider.ts</span></div>
<pre><code class="language-typescript">// Ingests entities from an external system with no catalog-info.yaml (e.g. a CMDB)
import { EntityProvider, EntityProviderConnection } from '@backstage/plugin-catalog-node';

export class EasypjCmdbProvider implements EntityProvider {
  private connection?: EntityProviderConnection;
  getProviderName() { return 'easypj-cmdb-provider'; }
  async connect(connection: EntityProviderConnection) {
    this.connection = connection;
  }
  async run() {
    const entities = await fetchFromCmdb(); // your own integration
    await this.connection?.applyMutation({ type: 'full', entities });
  }
}</code></pre>
                </div>
            </section>

