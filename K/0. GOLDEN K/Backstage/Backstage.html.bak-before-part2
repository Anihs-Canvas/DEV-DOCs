                <h3 class="section-h">18.3 Creating a Backend Plugin</h3>
                <p>Backend plugins expose API endpoints and access the database, read URLs, and communicate with other plugins via the event bus. Scaffold with <code>yarn new</code> (interactive) or <code>backstage-cli new --select backend-plugin</code>.</p>

                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">plugins/easypj-dashboard-backend/src/plugin.ts — New Backend System</span></div>
<pre><code class="language-typescript">import { createBackendPlugin, coreServices } from
  '@backstage/backend-plugin-api';
import { createEasypjRouter } from './service/router';

export const easypjDashboardBackendPlugin = createBackendPlugin({
  pluginId: 'easypj-dashboard',
  register(env) {
    env.registerInit({
      deps: { httpRouter: coreServices.httpRouter },
      async init({ httpRouter }) {
        httpRouter.use(await createEasypjRouter());
      },
    });
  },
});</code></pre>
                </div>

                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">router.ts — the actual endpoints</span></div>
<pre><code class="language-typescript">// plugins/easypj-dashboard-backend/src/service/router.ts
import express from 'express';
import Router from 'express-promise-router';

export async function createEasypjRouter() {
  const router = Router();
  router.use(express.json());

  // GET /api/easypj-dashboard/health
  router.get('/health', async (_, res) => {
    res.json({ status: 'ok' });
  });

  // GET /api/easypj-dashboard/job-stats
  router.get('/job-stats', async (req, res) => {
    res.json({ activePostings: 42, newToday: 3 });
  });

  return router;
}</code></pre>
                </div>

                <div class="card-grid cols-3">
                    <div class="info-card highlight"><div class="card-icon-lg">🗄️</div><h5>Database Access</h5><p>Via <code>PluginDatabaseManager</code> or the <code>coreServices.database</code> dependency. Provides a knex.js client. All DB queries run server-side — NEVER exposed to browser.</p></div>
                    <div class="info-card"><div class="card-icon-lg">📡</div><h5>Event Bus</h5><p>Publish/subscribe to events. Example: Catalog entity changes → your plugin re-indexes. Loose coupling between plugins.</p></div>
                    <div class="info-card"><div class="card-icon-lg">🔗</div><h5>Express Router</h5><p>Standard Express.js patterns. <code>router.get()</code>, <code>router.post()</code>. Frontend calls via <code>/api/plugin-name/...</code>.</p></div>
