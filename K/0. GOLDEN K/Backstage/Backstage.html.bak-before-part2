                <h4>Complete Annotated app-config.yaml Example</h4>
                <p>Below is a <strong>production-ready</strong> app-config.yaml for the easypj portal, with every section annotated. Study this — the CBA will ask about specific sections!</p>

                <div class="diagram-container">
                    <div class="diagram-title">app-config.yaml — Full Production Example for easypj</div>
<pre><code class="language-yaml"># ======================================================
# app-config.yaml — Backstage Central Configuration
# ======================================================

<span class="comment"># 1️⃣ APP: Portal identity, branding, and URL</span>
app:
  title: easypj Developer Portal        <span class="comment"># ← Displayed in browser tab & header</span>
  baseUrl: https://backstage.easypj.com <span class="comment"># ← Public URL (prod) or localhost (dev)</span>

<span class="comment"># 2️⃣ ORGANIZATION: Your company name</span>
organization:
  name: Easypj Corp

<span class="comment"># 3️⃣ BACKEND: Server configuration & database</span>
backend:
  baseUrl: http://localhost:7007        <span class="comment"># ← Internal backend URL</span>
  listen:                               <span class="comment"># ← (optional) Bind address</span>
    port: 7007
  cors:
    origin: http://localhost:3000       <span class="comment"># ← Allow frontend to call backend</span>
    methods: [GET, POST, PUT, DELETE]
    credentials: true
  database:                             <span class="comment"># ← CRITICAL: SQLite vs PostgreSQL</span>
    client: pg                          <span class="comment"># ← 'better-sqlite3' for dev, 'pg' for prod</span>
    connection:
      host: ${POSTGRES_HOST}            <span class="comment"># ← USE ENV VARS FOR SECRETS!</span>
      port: ${POSTGRES_PORT}
      user: ${POSTGRES_USER}
      password: ${POSTGRES_PASSWORD}
  cache:
    store: memory                       <span class="comment"># ← 'memory' for dev, 'redis' for prod</span>

<span class="comment"># 4️⃣ CATALOG: Where entities come from</span>
catalog:
  locations:                            <span class="comment"># ← Manual locations (URLs or files)</span>
    - type: url
      target: https://github.com/easypj/jobpost/blob/main/catalog-info.yaml
    - type: url
      target: https://github.com/easypj/infra/blob/main/catalog-info.yaml
  rules:                                <span class="comment"># ← (optional) Filter which entities to allow</span>
    - allow: [Component, API, System, Domain, Resource, User, Group]

<span class="comment"># 5️⃣ SCAFFOLDER: Software Templates location</span>
scaffolder: {}
  <span class="comment"># Templates are typically registered via catalog locations</span>

<span class="comment"># 6️⃣ TECHDOCS: Documentation build & publish</span>
techdocs:
  builder: 'local'                      <span class="comment"># ← 'local' for dev, 'docker' for prod</span>
  generator:
    runIn: 'local'                      <span class="comment"># ← Run mkdocs locally or in container</span>
  publisher:
    type: 'local'                       <span class="comment"># ← 'local', 'googleGcs', 'awsS3', 'azureBlobStorage'</span>

<span class="comment"># 7️⃣ AUTH: Authentication providers</span>
auth:
  providers:
    github:                             <span class="comment"># ← GitHub OAuth</span>
      development:
        clientId: ${GITHUB_CLIENT_ID}
        clientSecret: ${GITHUB_CLIENT_SECRET}

<span class="comment"># 8️⃣ INTEGRATIONS: External service connections</span>
integrations:
  github:
    - host: github.com
      token: ${GITHUB_TOKEN}            <span class="comment"># ← Personal Access Token for API access</span>

<span class="comment"># 9️⃣ PROXY: Forward API calls through Backstage</span>
proxy:
  endpoints:
    '/jenkins':
      target: https://jenkins.easypj.com
      changeOrigin: true
      headers:
        Authorization: Bearer ${JENKINS_TOKEN}

<span class="comment"># 🔟 KUBERNETES: Connect to K8s clusters</span>
kubernetes:
  serviceLocatorMethod:
    type: 'multiTenant'                 <span class="comment"># ← How services are found in K8s</span>
  clusterLocatorMethods:
    - type: 'config'
      clusters:
        - name: 'easypj-prod'
          url: 'https://k8s.easypj.com'
          authProvider: 'serviceAccount'
          serviceAccountToken: ${K8S_SA_TOKEN}</code></pre>
