            <section class="section-block" id="b-s18-4">
                <h3 class="section-h">18.4 Building the easypj Dashboard Plugin</h3>
                <p>Purpose: Custom dashboard showing jobpost metrics — active job listings, applications per day, deployment status, and recent errors. Frontend: React components with Material UI cards and charts. Backend: API endpoints aggregating data from the jobpost database, Kubernetes API, and Sentry.</p>

                <div class="diagram-container"><div class="diagram-title">easypj Dashboard Plugin — Full-Stack Architecture</div>
<pre>
  ┌──────────────────────────────────────────────────────────────────┐
  │              easypj DASHBOARD PLUGIN (Full-Stack)                  │
  │                                                                  │
  │  FRONTEND (React + MUI)              BACKEND (Express)           │
  │  ┌────────────────────────┐        ┌────────────────────────┐  │
  │  │  DashboardPage.tsx     │        │  GET /api/easypj-       │  │
  │  │  ┌──────────────────┐  │        │    dashboard/job-stats │──▶ jobpost DB
  │  │  │  JobStatsCard     │──┼───────▶│                        │  │
  │  │  │  📊 Active: 12   │  │        │  GET .../k8s-status    │──▶ K8s API
  │  │  │  📈 Today:  45   │  │        │                        │  │
  │  │  │  ✅ Deploy: ok   │  │        │  GET .../errors        │──▶ Sentry
  │  │  └──────────────────┘  │        └────────────────────────┘  │
  │  │  discoveryApi.getBaseUrl('easypj-dashboard') → never hardcoded │
  │  └────────────────────────┘                                    │
  └──────────────────────────────────────────────────────────────────┘
</pre></div>

                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">plugins/easypj-dashboard/src/components/DashboardPage.tsx</span></div>
<pre><code class="language-typescript">import { useApi, discoveryApiRef } from '@backstage/core-plugin-api';
import { InfoCard, Progress } from '@backstage/core-components';
import useAsync from 'react-use/lib/useAsync';

export const DashboardPage = () => {
  const discoveryApi = useApi(discoveryApiRef);
  const { value, loading } = useAsync(async () => {
    const baseUrl = await discoveryApi.getBaseUrl('easypj-dashboard');
    const res = await fetch(baseUrl + '/job-stats');
    return res.json();
  });
  if (loading) return &lt;Progress /&gt;;
  return &lt;InfoCard title='Job Stats'&gt;{value.activePostings} active&lt;/InfoCard&gt;;
};</code></pre>
                </div>

                <div class="card-grid cols-2">
                    <div class="info-card highlight"><div class="card-icon-lg">📊</div><h5>3 Data Sources</h5><p>jobpost DB (active listings, applications), K8s API (pod health, restarts), Sentry API (error counts, critical issues). Backend aggregates; frontend displays.</p></div>
