                <div class="comparison-table">
                    <table>
                        <thead><tr><th>Action</th><th>What It Does</th><th>Key Inputs</th><th>Key Outputs</th></tr></thead>
                        <tbody>
                            <tr><td><code>fetch:template</code></td><td>Copy skeleton files with placeholder replacement</td><td>url, values</td><td>—</td></tr>
                            <tr><td><code>fetch:plain</code></td><td>Copy files from URL (no placeholders)</td><td>url, targetPath</td><td>—</td></tr>
                            <tr><td><code>fetch:cookiecutter</code></td><td>Use Cookiecutter templates</td><td>url, values, extract</td><td>—</td></tr>
