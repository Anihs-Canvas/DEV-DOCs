                <div class="code-block-wrapper">
                    <div class="code-block-header"><span class="code-dot red"></span><span class="code-dot yellow"></span><span class="code-dot green"></span><span class="code-lang">k8s/overlays/production/kustomization.yaml — GitOps Image Update</span></div>
<pre><code class="language-yaml">apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../../base          # Base manifests (Deployment, Service, etc.)

namespace: backstage

images:
  - name: jobpost
    newName: ghcr.io/easypj/jobpost
    newTag: v2.4.2      # ← ArgoCD watches this. CI/CD updates this tag.

# ArgoCD Application that watches this kustomization
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: jobpost
  namespace: argocd
  annotations:
    # Links this ArgoCD app to the Backstage entity
    argocd/app-name: jobpost
spec:
  project: default
  source:
    repoURL: https://github.com/easypj/k8s-manifests
    path: overlays/production
    targetRevision: main
  destination:
    server: https://kubernetes.default.svc
    namespace: backstage
  syncPolicy:
    automated:
      prune: true        # Remove resources not in Git
      selfHeal: true     # Auto-fix drift
    syncOptions:
      - CreateNamespace=true</code></pre>
