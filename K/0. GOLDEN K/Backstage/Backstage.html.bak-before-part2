                        <div class="eq-answer-label">Answer</div>
                        <table>
                            <thead><tr><th></th><th>Role</th></tr></thead>
                            <tbody>
                                <tr><td>Provider</td><td>Reads raw entity data — knows HOW to read from a source</td></tr>
                                <tr><td>Processor</td><td>Transforms, validates, enriches — checks YAML syntax, resolves placeholders</td></tr>
                            </tbody>
