<pre><code class="language-yaml">apiVersion: scaffolder.backstage.io/v1beta3
kind: Template
metadata:
  name: django-service
  title: New Django Microservice
  tags: [django, python, recommended]
spec:
  owner: team-platform
  type: service
  parameters:
    - title: Service Details
      required: [name, owner]
