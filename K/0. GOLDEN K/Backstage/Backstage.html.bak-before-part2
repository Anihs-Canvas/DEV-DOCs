<pre><code class="language-yaml">apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: jobpost
  description: Job posting service for easypj platform
  annotations:
    github.com/project-slug: easypj/jobpost
    backstage.io/techdocs-ref: dir:.
    backstage.io/kubernetes-id: jobpost
spec:
  type: service          # service | website | library | CLI
  lifecycle: production  # production | experimental | deprecated
  owner: team-platform
  system: easypj-platform
  providesApis:
    - jobpost-api
  dependsOn:
    - resource:easypj-postgres</code></pre>
