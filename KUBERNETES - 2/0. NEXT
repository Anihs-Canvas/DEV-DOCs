cat > anihpj-deploy.yaml << 'EOF'
# ============================================
#  1. NAMESPACE — isolate the anihpj app
# ============================================
apiVersion: v1
kind: Namespace
metadata:
  name: anihpj
---
# ============================================
#  2. DATABASE — PostgreSQL (tier: db)  ✅ OK
# ============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anihpj-db
  namespace: anihpj
spec:
  replicas: 1
  selector:
    matchLabels:
      app: anihpj
      tier: db
  template:
    metadata:
      labels:
        app: anihpj
        tier: db
    spec:
      containers:
      - name: postgres
        image: postgres:15-alpine
        env:
        - name: POSTGRES_DB
          value: jobpost
        - name: POSTGRES_USER
          value: anihpj
        - name: POSTGRES_PASSWORD
          value: secret123
        ports:
        - containerPort: 5432
---
# ============================================
#  3. DB SERVICE — internal ClusterIP for :5432  ✅ OK
# ============================================
apiVersion: v1
kind: Service
metadata:
  name: anihpj-db
  namespace: anihpj
spec:
  selector:
    app: anihpj
    tier: db
  ports:
  - port: 5432
    targetPort: 5432
---
# ============================================
#  4. API — nginx REST backend (tier: ap1)  ❌ BUG!
#  Pod labels say "tier: ap1" but the Service
#  selector below expects "tier: api" — MISMATCH!
# ============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anihpj-api
  namespace: anihpj
spec:
  replicas: 2
  selector:
    matchLabels:
      app: anihpj
      tier: ap1
  template:
    metadata:
      labels:
        app: anihpj
        tier: ap1
    spec:
      containers:
      - name: api
        image: nginx:alpine
        ports:
        - containerPort: 8080
---
# ============================================
#  5. API SERVICE — selector expects tier: api  ⚠️
#  Service looks for "tier: api" but pods have
#  "tier: ap1" → Service has NO endpoints!
# ============================================
apiVersion: v1
kind: Service
metadata:
  name: anihpj-api
  namespace: anihpj
spec:
  selector:
    app: anihpj
    tier: api
  ports:
  - port: 8080
    targetPort: 8080
---
# ============================================
#  6. WEB — nginx frontend (tier: web)  ✅ OK
# ============================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: anihpj-web
  namespace: anihpj
spec:
  replicas: 2
  selector:
    matchLabels:
      app: anihpj
      tier: web
  template:
    metadata:
      labels:
        app: anihpj
        tier: web
    spec:
      containers:
      - name: web
        image: nginx:alpine
        ports:
        - containerPort: 8000
EOF
